# ================================================================
# IntLab Analytics - Konfigurace prostředí
# ================================================================
# Zkopíruj tento soubor jako .env.local a doplň skutečné hodnoty.
# NIKDY necommituj .env.local do Gitu!

# --- Cloudflare přihlašovací údaje ---

# Account ID: Najdeš ho v pravém postranním panelu na dash.cloudflare.com
NEXT_PUBLIC_CF_ACCOUNT_ID=tvuj_account_id_zde

# API Token: Vytvoř ho na dash.cloudflare.com/profile/api-tokens
# Potřebné oprávnění: "Account Analytics Read" a "Account Settings Read"
NEXT_PUBLIC_CF_API_TOKEN=tvuj_api_token_zde

# Site Tag: Toto je identifikátor tvého Web Analytics webu (NENÍ to beacon token).
# Najdeš ho v Cloudflare dashboardu: Analytics > Web Analytics > Vyber web > Settings
NEXT_PUBLIC_CF_SITE_TAG=tvuj_site_tag_zde
