      arguments_json: "{\"Instruction\":\"Enlarge the diagram, add transition durations, and implement a progress animation for active transitions.\",\"ReplacementContent\":\"interface Transition {\\n  id: string;\\n  label: string;\\n  x: number;\\n  y: number;\\n  inputs: string[];\\n  outputs: string[];\\n  icon?: React.ReactNode;\\n  duration: number;\\n}\\n\\nconst INITIAL_PLACES: Place[] = [\\n  { id: \'s0\', label: \'Vstup\', x: 100, y: 350, tokens: 1, icon: <Package className=\\\"w-5 h-5\\\" /> },\\n  { id: \'s1\', label: \'Napln\304\233n\303\241 bedna\', x: 300, y: 100, tokens: 0, icon: <Package className=\\\"w-5 h-5 text-blue-500\\\" /> },\\n  { id: \'s2\', label: \'Linka 1 voln\303\241\', x: 300, y: 350, tokens: 1, icon: <Settings className=\\\"w-5 h-5\\\" /> },\\n  { id: \'s3\', label: \'Mezisklad\', x: 600, y: 225, tokens: 0, icon: <Warehouse className=\\\"w-5 h-5 text-amber-600\\\" /> },\\n  { id: \'s4\', label: \'Linka 2 voln\303\241\', x: 900, y: 100, tokens: 1, icon: <Settings className=\\\"w-5 h-5\\\" /> },\\n  { id: \'s5\', label: \'Napln\304\233n\303\241 bedna\', x: 900, y: 350, tokens: 0, icon: <Package className=\\\"w-5 h-5 text-blue-500\\\" /> },\\n  { id: \'s6\', label: \'Expedice\', x: 1100, y: 100, tokens: 0, icon: <Truck className=\\\"w-5 h-5 text-emerald-600\\\" /> },\\n];\\n\\nconst TRANSITIONS: Transition[] = [\\n  { id: \'t1\', label: \'Pln\304\233n\303\255\', x: 200, y: 225, inputs: [\'s0\', \'s2\'], outputs: [\'s1\'], icon: <Droplets className=\\\"w-5 h-5\\\" />, duration: 2000 },\\n  { id: \'t2\', label: \'Uskladn\304\233n\303\255\', x: 450, y: 225, inputs: [\'s1\'], outputs: [\'s0\', \'s2\', \'s3\'], icon: <Truck className=\\\"w-5 h-5\\\" />, duration: 1500 },\\n  { id: \'t3\', label: \'Pod\303\241n\303\255\', x: 750, y: 225, inputs: [\'s3\', \'s4\'], outputs: [\'s5\'], icon: <Truck className=\\\"w-5 h-5\\\" />, duration: 1500 },\\n  { id: \'t4\', label: \'Zaz\303\241tkov\303\241n\303\255\', x: 1000, y: 225, inputs: [\'s5\'], outputs: [\'s4\', \'s6\'], icon: <Lock className=\\\"w-5 h-5\\\" />, duration: 2500 },\\n];\\n\\ninterface ParallelProcessesProps {\\n  onBack: () => void;\\n}\\n\\nconst ParallelProcesses: React.FC<ParallelProcessesProps> = ({ onBack }) => {\\n  const [places, setPlaces] = useState<Place[]>(INITIAL_PLACES);\\n  const [history, setHistory] = useState<string[]>([]);\\n  const [activeTransitionId, setActiveTransitionId] = useState<string | null>(null);\\n\\n  const isEnabled = (t: Transition) => {\\n    return t.inputs.every(inputId => {\\n      const place = places.find(p => p.id === inputId);\\n      return place && place.tokens > 0;\\n    });\\n  };\\n\\n  const fireTransition = (t: Transition) => {\\n    if (!isEnabled(t) || activeTransitionId) return;\\n\\n    setActiveTransitionId(t.id);\\n    \\n    // Step 1: Consume tokens\\n    setPlaces(prev => prev.map(p => {\\n      if (t.inputs.includes(p.id)) {\\n        return { ...p, tokens: p.tokens - 1 };\\n      }\\n      return p;\\n    }));\\n\\n    // Step 2: Add tokens after a delay (animation simulation)\\n    setTimeout(() => {\\n      setPlaces(prev => prev.map(p => {\\n        if (t.outputs.includes(p.id)) {\\n          return { ...p, tokens: p.tokens + 1 };\\n        }\\n        return p;\\n      }));\\n      setHistory(prev => [...prev, t.label]);\\n      setActiveTransitionId(null);\\n    }, t.duration);\\n  };\\n\\n  const reset = () => {\\n    setPlaces(INITIAL_PLACES);\\n    setHistory([]);\\n    setActiveTransitionId(null);\\n  };\\n\\n  return (\\n    <div className=\\\"w-full max-w-7xl flex flex-col gap-8 items-center animate-in fade-in duration-500 pb-20\\\">\\n      <div className=\\\"w-full bg-white p-6 rounded-[2.5rem] shadow-lg border border-gray-100 flex items-center justify-between\\\">\\n        <button \\n          onClick={onBack}\\n          className=\\\"flex items-center text-gray-400 hover:text-purple-600 transition-colors font-black uppercase text-xs tracking-widest\\\"\\n        >\\n          <ArrowLeft className=\\\"w-5 h-5 mr-2\\\" />\\n          Zp\304\233t\\n        </button>\\n        <h2 className=\\\"text-xl font-black text-gray-800 uppercase tracking-tight\\\">Paraleln\303\255 procesy: Petriho s\303\255t\304\233</h2>\\n        <button \\n          onClick={reset}\\n          className=\\\"p-2 hover:bg-purple-50 rounded-xl transition-colors text-purple-600\\\"\\n          title=\\\"Resetovat simulaci\\\"\\n        >\\n          <RefreshCcw className=\\\"w-6 h-6\\\" />\\n        </button>\\n      </div>\\n\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-8 w-full\\\">\\n        {/* Simulation Workspace */}\\n        <div className=\\\"lg:col-span-9 bg-white p-8 rounded-[3rem] shadow-xl border border-gray-100 flex flex-col items-center relative overflow-hidden\\\">\\n          <div className=\\\"w-full flex justify-between items-start mb-8\\\">\\n            <div>\\n              <h3 className=\\\"text-lg font-black text-gray-800 uppercase tracking-tight\\\">Model pln\303\255c\303\255 linky</h3>\\n              <p className=\\\"text-xs text-gray-400 font-bold uppercase mt-1 tracking-wider\\\">Kliknut\303\255m na aktivn\303\255 p\305\231echody (\304\215ern\303\251 obd\303\251ln\303\255ky) posouvej proces.</p>\\n            </div>\\n          </div>\\n          \\n          <div className=\\\"w-full aspect-[16/7] relative bg-gray-50 rounded-[2rem] border-2 border-dashed border-gray-200 flex items-center justify-center overflow-hidden\\\">\\n            <svg viewBox=\\\"0 0 1200 450\\\" className=\\\"w-full h-full p-4\\\">\\n              {/* Arcs */}\\n              {TRANSITIONS.map(t => (\\n                <React.Fragment key={`arcs-${t.id}`}>\\n                  {t.inputs.map(inputId => {\\n                    const p = places.find(p => p.id === inputId)!;\\n                    return (\\n                      <line \\n                        key={`${p.id}-${t.id}`}\\n                        x1={p.x} y1={p.y} x2={t.x} y2={t.y}\\n                        stroke=\\\"#cbd5e1\\\" strokeWidth=\\\"3\\\" markerEnd=\\\"url(#arrowhead)\\\"\\n                      />\\n                    );\\n                  })}\\n                  {t.outputs.map(outputId => {\\n                    const p = places.find(p => p.id === outputId)!;\\n                    return (\\n                      <line \\n                        key={`${t.id}-${p.id}`}\\n                        x1={t.x} y1={t.y} x2={p.x} y2={p.y}\\n                        stroke=\\\"#cbd5e1\\\" strokeWidth=\\\"3\\\" markerEnd=\\\"url(#arrowhead)\\\"\\n                      />\\n                    );\\n                  })}\\n                </React.Fragment>\\n              ))}\\n\\n              <defs>\\n                <marker id=\\\"arrowhead\\\" markerWidth=\\\"10\\\" markerHeight=\\\"7\\\" refX=\\\"9\\\" refY=\\\"3.5\\\" orient=\\\"auto\\\">\\n                  <polygon points=\\\"0 0, 10 3.5, 0 7\\\" fill=\\\"#cbd5e1\\\" />\\n                </marker>\\n              </defs>\\n\\n              {/* Places */}\\n              {places.map(p => (\\n                <g key={p.id}>\\n                  <circle \\n                    cx={p.x} cy={p.y} r=\\\"35\\\"\\n                    fill=\\\"white\\\" stroke=\\\"#94a3b8\\\" strokeWidth=\\\"3\\\"\\n                  />\\n                  {p.icon && (\\n                    <foreignObject x={p.x - 10} y={p.y - 10} width=\\\"20\\\" height=\\\"20\\\">\\n                      <div className=\\\"flex items-center justify-center text-gray-400\\\">\\n                        {p.icon}\\n                      </div>\\n                    </foreignObject>\\n                  )}\\n                  <text \\n                    x={p.x} y={p.y + 60} textAnchor=\\\"middle\\\"\\n                    className=\\\"text-[12px] font-black fill-gray-500 uppercase tracking-tighter\\\"\\n                  >\\n                    {p.label}\\n                  </text>\\n                  \\n                  {/* Tokens */}\\n                  <AnimatePresence>\\n                    {Array.from({ length: p.tokens }).map((_, i) => (\\n                      <motion.circle \\n                        key={`${p.id}-token-${i}`}\\n                        initial={{ scale: 0 }}\\n                        animate={{ scale: 1 }}\\n                        exit={{ scale: 0 }}\\n                        cx={p.x + (i % 2 === 0 ? -15 : 15) * (p.tokens > 1 ? 1 : 0)} \\n                        cy={p.y + (i < 2 ? -15 : 15) * (p.tokens > 2 ? 1 : 0)} \\n                        r=\\\"8\\\"\\n                        fill=\\\"#8b5cf6\\\"\\n                        className=\\\"shadow-sm\\\"\\n                      />\\n                    ))}\\n                  </AnimatePresence>\\n                </g>\\n              ))}\\n\\n              {/* Transitions */}\\n              {TRANSITIONS.map(t => {\\n                const active = isEnabled(t);\\n                const isProcessing = activeTransitionId === t.id;\\n                return (\\n                  <motion.g \\n                    key={t.id} \\n                    onClick={() => fireTransition(t)}\\n                    whileHover={active && !activeTransitionId ? { scale: 1.1 } : {}}\\n                    whileTap={active && !activeTransitionId ? { scale: 0.95 } : {}}\\n                    style={{ transformOrigin: `${t.x}px ${t.y}px` }}\\n                    className={`cursor-pointer transition-opacity duration-300 ${active && !activeTransitionId ? \'opacity-100\' : \'opacity-40 grayscale\'}`}\\n                  >\\n                    {/* Invisible larger click target */}\\n                    <rect \\n                      x={t.x - 40} y={t.y - 50} width=\\\"80\\\" height=\\\"100\\\"\\n                      fill=\\\"transparent\\\"\\n                    />\\n                    <rect \\n                      x={t.x - 15} y={t.y - 40} width=\\\"30\\\" height=\\\"80\\\"\\n                      fill={active ? \\\"#1e293b\\\" : \\\"#94a3b8\\\"}\\n                      rx=\\\"6\\\"\\n                    />\\n                    \\n                    {/* Progress indicator */}\\n                    {isProcessing && (\\n                      <motion.rect \\n                        initial={{ height: 0 }}\\n                        animate={{ height: 80 }}\\n                        transition={{ duration: t.duration / 1000, ease: \\\"linear\\\" }}\\n                        x={t.x - 15} y={t.y - 40} width=\\\"30\\\"\\n                        fill=\\\"#8b5cf6\\\"\\n                        rx=\\\"6\\\"\\n                        className=\\\"opacity-40\\\"\\n                      />\\n                    )}\\n\\n                    {t.icon && (\\n                      <foreignObject x={t.x - 10} y={t.y - 10} width=\\\"20\\\" height=\\\"20\\\">\\n                        <div className=\\\"flex items-center justify-center text-white\\\">\\n                          {t.icon}\\n                        </div>\\n                      </foreignObject>\\n                    )}\\n                    <text \\n                      x={t.x} y={t.y - 55} textAnchor=\\\"middle\\\"\\n                      className={`text-[12px] font-black uppercase tracking-widest ${active ? \'fill-gray-800\' : \'fill-gray-400\'}`}\\n                    >\\n                      {t.label}\\n                    </text>\\n                    \\n                    {active && !isProcessing && (\\n                      <motion.circle \\n                        animate={{ scale: [1, 1.2, 1] }}\\n                        transition={{ repeat: Infinity, duration: 1.5 }}\\n                        cx={t.x} cy={t.y + 25} r=\\\"4\\\" fill=\\\"white\\\"\\n                      />\\n                    )}\\n\\n                    {isProcessing && (\\n                      <text \\n                        x={t.x} y={t.y + 60} textAnchor=\\\"middle\\\"\\n                        className=\\\"text-[10px] font-black fill-purple-600 animate-pulse\\\"\\n                      >\\n                        PROB\303\215H\303\201...\\n                      </text>\\n                    )}\\n                  </motion.g>\\n                );\\n              })}\\n            </svg>\\n          </div>\",\"TargetContent\":\"interface Transition {\\n  id: string;\\n  label: string;\\n  x: number;\\n  y: number;\\n  inputs: string[];\\n  outputs: string[];\\n  icon?: React.ReactNode;\\n}\\n\\nconst INITIAL_PLACES: Place[] = [\\n  { id: \'s0\', label: \'Vstup\', x: 100, y: 250, tokens: 1, icon: <Package className=\\\"w-4 h-4\\\" /> },\\n  { id: \'s1\', label: \'Napln\304\233n\303\241 bedna\', x: 250, y: 100, tokens: 0, icon: <Package className=\\\"w-4 h-4 text-blue-500\\\" /> },\\n  { id: \'s2\', label: \'Linka 1 voln\303\241\', x: 250, y: 250, tokens: 1, icon: <Settings className=\\\"w-4 h-4\\\" /> },\\n  { id: \'s3\', label: \'Mezisklad\', x: 450, y: 175, tokens: 0, icon: <Warehouse className=\\\"w-4 h-4 text-amber-600\\\" /> },\\n  { id: \'s4\', label: \'Linka 2 voln\303\241\', x: 650, y: 100, tokens: 1, icon: <Settings className=\\\"w-4 h-4\\\" /> },\\n  { id: \'s5\', label: \'Napln\304\233n\303\241 bedna\', x: 650, y: 250, tokens: 0, icon: <Package className=\\\"w-4 h-4 text-blue-500\\\" /> },\\n  { id: \'s6\', label: \'Expedice\', x: 800, y: 100, tokens: 0, icon: <Truck className=\\\"w-4 h-4 text-emerald-600\\\" /> },\\n];\\n\\nconst TRANSITIONS: Transition[] = [\\n  { id: \'t1\', label: \'Pln\304\233n\303\255\', x: 175, y: 175, inputs: [\'s0\', \'s2\'], outputs: [\'s1\'], icon: <Droplets className=\\\"w-4 h-4\\\" /> },\\n  { id: \'t2\', label: \'Uskladn\304\233n\303\255\', x: 325, y: 175, inputs: [\'s1\'], outputs: [\'s0\', \'s2\', \'s3\'], icon: <Truck className=\\\"w-4 h-4\\\" /> },\\n  { id: \'t3\', label: \'Pod\303\241n\303\255\', x: 550, y: 175, inputs: [\'s3\', \'s4\'], outputs: [\'s5\'], icon: <Truck className=\\\"w-4 h-4\\\" /> },\\n  { id: \'t4\', label: \'Zaz\303\241tkov\303\241n\303\255\', x: 725, y: 175, inputs: [\'s5\'], outputs: [\'s4\', \'s6\'], icon: <Lock className=\\\"w-4 h-4\\\" /> },\\n];\\n\\ninterface ParallelProcessesProps {\\n  onBack: () => void;\\n}\\n\\nconst ParallelProcesses: React.FC<ParallelProcessesProps> = ({ onBack }) => {\\n  const [places, setPlaces] = useState<Place[]>(INITIAL_PLACES);\\n  const [history, setHistory] = useState<string[]>([]);\\n  const [isAnimating, setIsAnimating] = useState(false);\\n\\n  const isEnabled = (t: Transition) => {\\n    return t.inputs.every(inputId => {\\n      const place = places.find(p => p.id === inputId);\\n      return place && place.tokens > 0;\\n    });\\n  };\\n\\n  const fireTransition = (t: Transition) => {\\n    if (!isEnabled(t) || isAnimating) return;\\n\\n    setIsAnimating(true);\\n    \\n    // Step 1: Consume tokens\\n    setPlaces(prev => prev.map(p => {\\n      if (t.inputs.includes(p.id)) {\\n        return { ...p, tokens: p.tokens - 1 };\\n      }\\n      return p;\\n    }));\\n\\n    // Step 2: Add tokens after a delay (animation simulation)\\n    setTimeout(() => {\\n      setPlaces(prev => prev.map(p => {\\n        if (t.outputs.includes(p.id)) {\\n          return { ...p, tokens: p.tokens + 1 };\\n        }\\n        return p;\\n      }));\\n      setHistory(prev => [...prev, t.label]);\\n      setIsAnimating(false);\\n    }, 600);\\n  };\\n\\n  const reset = () => {\\n    setPlaces(INITIAL_PLACES);\\n    setHistory([]);\\n    setIsAnimating(false);\\n  };\\n\\n  return (\\n    <div className=\\\"w-full max-w-6xl flex flex-col gap-8 items-center animate-in fade-in duration-500 pb-20\\\">\\n      <div className=\\\"w-full bg-white p-6 rounded-[2.5rem] shadow-lg border border-gray-100 flex items-center justify-between\\\">\\n        <button \\n          onClick={onBack}\\n          className=\\\"flex items-center text-gray-400 hover:text-purple-600 transition-colors font-black uppercase text-xs tracking-widest\\\"\\n        >\\n          <ArrowLeft className=\\\"w-5 h-5 mr-2\\\" />\\n          Zp\304\233t\\n        </button>\\n        <h2 className=\\\"text-xl font-black text-gray-800 uppercase tracking-tight\\\">Paraleln\303\255 procesy: Petriho s\303\255t\304\233</h2>\\n        <button \\n          onClick={reset}\\n          className=\\\"p-2 hover:bg-purple-50 rounded-xl transition-colors text-purple-600\\\"\\n          title=\\\"Resetovat simulaci\\\"\\n        >\\n          <RefreshCcw className=\\\"w-6 h-6\\\" />\\n        </button>\\n      </div>\\n\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-8 w-full\\\">\\n        {/* Simulation Workspace */}\\n        <div className=\\\"lg:col-span-9 bg-white p-10 rounded-[3rem] shadow-xl border border-gray-100 flex flex-col items-center relative overflow-hidden\\\">\\n          <div className=\\\"w-full flex justify-between items-start mb-8\\\">\\n            <div>\\n              <h3 className=\\\"text-lg font-black text-gray-800 uppercase tracking-tight\\\">Model pln\303\255c\303\255 linky</h3>\\n              <p className=\\\"text-xs text-gray-400 font-bold uppercase mt-1 tracking-wider\\\">Kliknut\303\255m na aktivn\303\255 p\305\231echody (\304\215ern\303\251 obd\303\251ln\303\255ky) posouvej proces.</p>\\n            </div>\\n          </div>\\n          \\n          <div className=\\\"w-full aspect-[16/7] relative bg-gray-50 rounded-[2rem] border-2 border-dashed border-gray-200 flex items-center justify-center overflow-hidden\\\">\\n            <svg viewBox=\\\"0 0 900 350\\\" className=\\\"w-full h-full p-4\\\">\\n              {/* Arcs */}\\n              {TRANSITIONS.map(t => (\\n                <React.Fragment key={`arcs-${t.id}`}>\\n                  {t.inputs.map(inputId => {\\n                    const p = places.find(p => p.id === inputId)!;\\n                    return (\\n                      <line \\n                        key={`${p.id}-${t.id}`}\\n                        x1={p.x} y1={p.y} x2={t.x} y2={t.y}\\n                        stroke=\\\"#cbd5e1\\\" strokeWidth=\\\"2\\\" markerEnd=\\\"url(#arrowhead)\\\"\\n                      />\\n                    );\\n                  })}\\n                  {t.outputs.map(outputId => {\\n                    const p = places.find(p => p.id === outputId)!;\\n                    return (\\n                      <line \\n                        key={`${t.id}-${p.id}`}\\n                        x1={t.x} y1={t.y} x2={p.x} y2={p.y}\\n                        stroke=\\\"#cbd5e1\\\" strokeWidth=\\\"2\\\" markerEnd=\\\"url(#arrowhead)\\\"\\n                      />\\n                    );\\n                  })}\\n                </React.Fragment>\\n              ))}\\n\\n              <defs>\\n                <marker id=\\\"arrowhead\\\" markerWidth=\\\"10\\\" markerHeight=\\\"7\\\" refX=\\\"9\\\" refY=\\\"3.5\\\" orient=\\\"auto\\\">\\n                  <polygon points=\\\"0 0, 10 3.5, 0 7\\\" fill=\\\"#cbd5e1\\\" />\\n                </marker>\\n              </defs>\\n\\n              {/* Places */}\\n              {places.map(p => (\\n                <g key={p.id}>\\n                  <circle \\n                    cx={p.x} cy={p.y} r=\\\"25\\\"\\n                    fill=\\\"white\\\" stroke=\\\"#94a3b8\\\" strokeWidth=\\\"2\\\"\\n                  />\\n                  {p.icon && (\\n                    <foreignObject x={p.x - 8} y={p.y - 8} width=\\\"16\\\" height=\\\"16\\\">\\n                      <div className=\\\"flex items-center justify-center text-gray-400\\\">\\n                        {p.icon}\\n                      </div>\\n                    </foreignObject>\\n                  )}\\n                  <text \\n                    x={p.x} y={p.y + 45} textAnchor=\\\"middle\\\"\\n                    className=\\\"text-[10px] font-black fill-gray-500 uppercase tracking-tighter\\\"\\n                  >\\n                    {p.label}\\n                  </text>\\n                  <text \\n                    x={p.x + 20} y={p.y - 20} textAnchor=\\\"middle\\\"\\n                    className=\\\"text-[8px] font-bold fill-gray-300\\\"\\n                  >\\n                    {p.id}\\n                  </text>\\n                  \\n                  {/* Tokens */}\\n                  <AnimatePresence>\\n                    {Array.from({ length: p.tokens }).map((_, i) => (\\n                      <motion.circle \\n                        key={`${p.id}-token-${i}`}\\n                        initial={{ scale: 0 }}\\n                        animate={{ scale: 1 }}\\n                        exit={{ scale: 0 }}\\n                        cx={p.x + (i % 2 === 0 ? -12 : 12) * (p.tokens > 1 ? 1 : 0)} \\n                        cy={p.y + (i < 2 ? -12 : 12) * (p.tokens > 2 ? 1 : 0)} \\n                        r=\\\"6\\\"\\n                        fill=\\\"#8b5cf6\\\"\\n                        className=\\\"shadow-sm\\\"\\n                      />\\n                    ))}\\n                  </AnimatePresence>\\n                </g>\\n              ))}\\n\\n              {/* Transitions */}\\n              {TRANSITIONS.map(t => {\\n                const active = isEnabled(t);\\n                return (\\n                  <motion.g \\n                    key={t.id} \\n                    onClick={() => fireTransition(t)}\\n                    whileHover={active ? { scale: 1.1 } : {}}\\n                    whileTap={active ? { scale: 0.95 } : {}}\\n                    style={{ transformOrigin: `${t.x}px ${t.y}px` }}\\n                    className={`cursor-pointer transition-opacity duration-300 ${active ? \'opacity-100\' : \'opacity-40 grayscale\'}`}\\n                  >\\n                    {/* Invisible larger click target */}\\n                    <rect \\n                      x={t.x - 30} y={t.y - 40} width=\\\"60\\\" height=\\\"80\\\"\\n                      fill=\\\"transparent\\\"\\n                    />\\n                    <rect \\n                      x={t.x - 10} y={t.y - 30} width=\\\"20\\\" height=\\\"60\\\"\\n                      fill={active ? \\\"#1e293b\\\" : \\\"#94a3b8\\\"}\\n                      rx=\\\"4\\\"\\n                    />\\n                    {t.icon && (\\n                      <foreignObject x={t.x - 8} y={t.y - 8} width=\\\"16\\\" height=\\\"16\\\">\\n                        <div className=\\\"flex items-center justify-center text-white\\\">\\n                          {t.icon}\\n                        </div>\\n                      </foreignObject>\\n                    )}\\n                    <text \\n                      x={t.x} y={t.y - 40} textAnchor=\\\"middle\\\"\\n                      className={`text-[10px] font-black uppercase tracking-widest ${active ? \'fill-gray-800\' : \'fill-gray-400\'}`}\\n                    >\\n                      {t.label}\\n                    </text>\\n                    <text \\n                      x={t.x} y={t.y + 45} textAnchor=\\\"middle\\\"\\n                      className=\\\"text-[8px] font-bold fill-gray-300\\\"\\n                    >\\n                      {t.id}\\n                    </text>\\n                    {active && (\\n                      <motion.circle \\n                        animate={{ scale: [1, 1.2, 1] }}\\n                        transition={{ repeat: Infinity, duration: 1.5 }}\\n                        cx={t.x} cy={t.y + 20} r=\\\"3\\\" fill=\\\"white\\\"\\n                      />\\n                    )}\\n                  </motion.g>\\n                );\\n              })}\\n            </svg>\\n          </div>\",\"TargetFile\":\"/components/ParallelProcesses.tsx\",\"toolSummary\":\"Enlarging diagram and adding action durations with progress animations.\"}"
