  view_file {
    absolute_path_uri: "file:///components/ParallelProcesses.tsx"
    start_line: 19
    end_line: 39
    content: "  outputs: string[];\n}\n\nconst INITIAL_PLACES: Place[] = [\n  { id: \'s0\', label: \'Vstup\', x: 100, y: 250, tokens: 1 },\n  { id: \'s1\', label: \'Napln\304\233n\303\241 bedna\', x: 250, y: 100, tokens: 0 },\n  { id: \'s2\', label: \'Linka 1 voln\303\241\', x: 250, y: 250, tokens: 1 },\n  { id: \'s3\', label: \'Mezisklad\', x: 450, y: 175, tokens: 0 },\n  { id: \'s4\', label: \'Linka 2 voln\303\241\', x: 650, y: 100, tokens: 1 },\n  { id: \'s5\', label: \'Napln\304\233n\303\241 bedna\', x: 650, y: 250, tokens: 0 },\n  { id: \'s6\', label: \'Expedice\', x: 800, y: 100, tokens: 0 },\n];\n\nconst TRANSITIONS: Transition[] = [\n  { id: \'t1\', label: \'Pln\304\233n\303\255\', x: 175, y: 175, inputs: [\'s0\', \'s2\'], outputs: [\'s1\'] },\n  { id: \'t2\', label: \'Uskladn\304\233n\303\255\', x: 325, y: 175, inputs: [\'s1\'], outputs: [\'s2\', \'s3\'] },\n  { id: \'t3\', label: \'Pod\303\241n\303\255\', x: 550, y: 175, inputs: [\'s3\', \'s4\'], outputs: [\'s5\'] },\n  { id: \'t4\', label: \'Zaz\303\241tkov\303\241n\303\255\', x: 725, y: 175, inputs: [\'s5\'], outputs: [\'s4\', \'s6\'] },\n];\n\ninterface ParallelProcessesProps {"
    raw_content: "\nimport React, { useState, useEffect } from \'react\';\nimport { ArrowLeft, HelpCircle, RefreshCcw, Play, Package, Truck, Droplets, CircleDot } from \'lucide-react\';\nimport { motion, AnimatePresence } from \'motion/react\';\n\ninterface Place {\n  id: string;\n  label: string;\n  x: number;\n  y: number;\n  tokens: number;\n}\n\ninterface Transition {\n  id: string;\n  label: string;\n  x: number;\n  y: number;\n  inputs: string[];\n  outputs: string[];\n}\n\nconst INITIAL_PLACES: Place[] = [\n  { id: \'s0\', label: \'Vstup\', x: 100, y: 250, tokens: 1 },\n  { id: \'s1\', label: \'Napln\304\233n\303\241 bedna\', x: 250, y: 100, tokens: 0 },\n  { id: \'s2\', label: \'Linka 1 voln\303\241\', x: 250, y: 250, tokens: 1 },\n  { id: \'s3\', label: \'Mezisklad\', x: 450, y: 175, tokens: 0 },\n  { id: \'s4\', label: \'Linka 2 voln\303\241\', x: 650, y: 100, tokens: 1 },\n  { id: \'s5\', label: \'Napln\304\233n\303\241 bedna\', x: 650, y: 250, tokens: 0 },\n  { id: \'s6\', label: \'Expedice\', x: 800, y: 100, tokens: 0 },\n];\n\nconst TRANSITIONS: Transition[] = [\n  { id: \'t1\', label: \'Pln\304\233n\303\255\', x: 175, y: 175, inputs: [\'s0\', \'s2\'], outputs: [\'s1\'] },\n  { id: \'t2\', label: \'Uskladn\304\233n\303\255\', x: 325, y: 175, inputs: [\'s1\'], outputs: [\'s2\', \'s3\'] },\n  { id: \'t3\', label: \'Pod\303\241n\303\255\', x: 550, y: 175, inputs: [\'s3\', \'s4\'], outputs: [\'s5\'] },\n  { id: \'t4\', label: \'Zaz\303\241tkov\303\241n\303\255\', x: 725, y: 175, inputs: [\'s5\'], outputs: [\'s4\', \'s6\'] },\n];\n\ninterface ParallelProcessesProps {\n  onBack: () => void;\n}\n\nconst ParallelProcesses: React.FC<ParallelProcessesProps> = ({ onBack }) => {\n  const [places, setPlaces] = useState<Place[]>(INITIAL_PLACES);\n  const [history, setHistory] = useState<string[]>([]);\n  const [isAnimating, setIsAnimating] = useState(false);\n\n  const isEnabled = (t: Transition) => {\n    return t.inputs.every(inputId => {\n      const place = places.find(p => p.id === inputId);\n      return place && place.tokens > 0;\n    });\n  };\n\n  const fireTransition = (t: Transition) => {\n    if (!isEnabled(t) || isAnimating) return;\n\n    setIsAnimating(true);\n    \n    // Step 1: Consume tokens\n    setPlaces(prev => prev.map(p => {\n      if (t.inputs.includes(p.id)) {\n        return { ...p, tokens: p.tokens - 1 };\n      }\n      return p;\n    }));\n\n    // Step 2: Add tokens after a delay (animation simulation)\n    setTimeout(() => {\n      setPlaces(prev => prev.map(p => {\n        if (t.outputs.includes(p.id)) {\n          return { ...p, tokens: p.tokens + 1 };\n        }\n        return p;\n      }));\n      setHistory(prev => [...prev, t.label]);\n      setIsAnimating(false);\n    }, 600);\n  };\n\n  const reset = () => {\n    setPlaces(INITIAL_PLACES);\n    setHistory([]);\n    setIsAnimating(false);\n  };\n\n  return (\n    <div className=\"w-full max-w-6xl flex flex-col gap-8 items-center animate-in fade-in duration-500 pb-20\">\n      <div className=\"w-full bg-white p-6 rounded-[2.5rem] shadow-lg border border-gray-100 flex items-center justify-between\">\n        <button \n          onClick={onBack}\n          className=\"flex items-center text-gray-400 hover:text-purple-600 transition-colors font-black uppercase text-xs tracking-widest\"\n        >\n          <ArrowLeft className=\"w-5 h-5 mr-2\" />\n          Zp\304\233t\n        </button>\n        <h2 className=\"text-xl font-black text-gray-800 uppercase tracking-tight\">Paraleln\303\255 procesy: Petriho s\303\255t\304\233</h2>\n        <button \n          onClick={reset}\n          className=\"p-2 hover:bg-purple-50 rounded-xl transition-colors text-purple-600\"\n          title=\"Resetovat simulaci\"\n        >\n          <RefreshCcw className=\"w-6 h-6\" />\n        </button>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 w-full\">\n        {/* Simulation Workspace */}\n        <div className=\"lg:col-span-9 bg-white p-10 rounded-[3rem] shadow-xl border border-gray-100 flex flex-col items-center relative overflow-hidden\">\n          <div className=\"w-full flex justify-between items-start mb-8\">\n            <div>\n              <h3 className=\"text-lg font-black text-gray-800 uppercase tracking-tight\">Model pln\303\255c\303\255 linky</h3>\n              <p className=\"text-xs text-gray-400 font-bold uppercase mt-1 tracking-wider\">Kliknut\303\255m na aktivn\303\255 p\305\231echody (\304\215ern\303\251 obd\303\251ln\303\255ky) posouvej proces.</p>\n            </div>\n          </div>\n          \n          <div className=\"w-full aspect-[16/7] relative bg-gray-50 rounded-[2rem] border-2 border-dashed border-gray-200 flex items-center justify-center overflow-hidden\">\n            <svg viewBox=\"0 0 900 350\" className=\"w-full h-full p-4\">\n              {/* Arcs */}\n              {TRANSITIONS.map(t => (\n                <React.Fragment key={`arcs-${t.id}`}>\n                  {t.inputs.map(inputId => {\n                    const p = places.find(p => p.id === inputId)!;\n                    return (\n                      <line \n                        key={`${p.id}-${t.id}`}\n                        x1={p.x} y1={p.y} x2={t.x} y2={t.y}\n                        stroke=\"#cbd5e1\" strokeWidth=\"2\" markerEnd=\"url(#arrowhead)\"\n                      />\n                    );\n                  })}\n                  {t.outputs.map(outputId => {\n                    const p = places.find(p => p.id === outputId)!;\n                    return (\n                      <line \n                        key={`${t.id}-${p.id}`}\n                        x1={t.x} y1={t.y} x2={p.x} y2={p.y}\n                        stroke=\"#cbd5e1\" strokeWidth=\"2\" markerEnd=\"url(#arrowhead)\"\n                      />\n                    );\n                  })}\n                </React.Fragment>\n              ))}\n\n              <defs>\n                <marker id=\"arrowhead\" markerWidth=\"10\" markerHeight=\"7\" refX=\"9\" refY=\"3.5\" orient=\"auto\">\n                  <polygon points=\"0 0, 10 3.5, 0 7\" fill=\"#cbd5e1\" />\n                </marker>\n              </defs>\n\n              {/* Places */}\n              {places.map(p => (\n                <g key={p.id}>\n                  <circle \n                    cx={p.x} cy={p.y} r=\"25\"\n                    fill=\"white\" stroke=\"#94a3b8\" strokeWidth=\"2\"\n                  />\n                  <text \n                    x={p.x} y={p.y + 45} textAnchor=\"middle\"\n                    className=\"text-[10px] font-black fill-gray-500 uppercase tracking-tighter\"\n                  >\n                    {p.label}\n                  </text>\n                  <text \n                    x={p.x + 20} y={p.y - 20} textAnchor=\"middle\"\n                    className=\"text-[8px] font-bold fill-gray-300\"\n                  >\n                    {p.id}\n                  </text>\n                  \n                  {/* Tokens */}\n                  <AnimatePresence>\n                    {Array.from({ length: p.tokens }).map((_, i) => (\n                      <motion.circle \n                        key={`${p.id}-token-${i}`}\n                        initial={{ scale: 0 }}\n                        animate={{ scale: 1 }}\n                        exit={{ scale: 0 }}\n                        cx={p.x + (i % 2 === 0 ? -5 : 5) * (p.tokens > 1 ? 1 : 0)} \n                        cy={p.y + (i < 2 ? -5 : 5) * (p.tokens > 2 ? 1 : 0)} \n                        r=\"6\"\n                        fill=\"#8b5cf6\"\n                      />\n                    ))}\n                  </AnimatePresence>\n                </g>\n              ))}\n\n              {/* Transitions */}\n              {TRANSITIONS.map(t => {\n                const active = isEnabled(t);\n                return (\n                  <motion.g \n                    key={t.id} \n                    onClick={() => fireTransition(t)}\n                    whileHover={active ? { scale: 1.1 } : {}}\n                    whileTap={active ? { scale: 0.95 } : {}}\n                    style={{ transformOrigin: `${t.x}px ${t.y}px` }}\n                    className={`cursor-pointer transition-opacity duration-300 ${active ? \'opacity-100\' : \'opacity-40 grayscale\'}`}\n                  >\n                    {/* Invisible larger click target */}\n                    <rect \n                      x={t.x - 30} y={t.y - 40} width=\"60\" height=\"80\"\n                      fill=\"transparent\"\n                    />\n                    <rect \n                      x={t.x - 10} y={t.y - 30} width=\"20\" height=\"60\"\n                      fill={active ? \"#1e293b\" : \"#94a3b8\"}\n                      rx=\"4\"\n                    />\n                    <text \n                      x={t.x} y={t.y - 40} textAnchor=\"middle\"\n                      className={`text-[10px] font-black uppercase tracking-widest ${active ? \'fill-gray-800\' : \'fill-gray-400\'}`}\n                    >\n                      {t.label}\n                    </text>\n                    <text \n                      x={t.x} y={t.y + 45} textAnchor=\"middle\"\n                      className=\"text-[8px] font-bold fill-gray-300\"\n                    >\n                      {t.id}\n                    </text>\n                    {active && (\n                      <motion.circle \n                        animate={{ scale: [1, 1.2, 1] }}\n                        transition={{ repeat: Infinity, duration: 1.5 }}\n                        cx={t.x} cy={t.y} r=\"4\" fill=\"white\"\n                      />\n                    )}\n                  </motion.g>\n                );\n              })}\n            </svg>\n          </div>\n\n          <div className=\"mt-8 w-full p-6 bg-purple-50 rounded-2xl border border-purple-100 flex gap-4\">\n            <HelpCircle className=\"w-6 h-6 text-purple-500 shrink-0\" />\n            <div className=\"text-xs text-purple-800 font-medium leading-relaxed\">\n              <p className=\"font-black uppercase mb-2\">Jak to funguje?</p>\n              <ul className=\"list-disc ml-4 space-y-1\">\n                <li><strong>M\303\255sta (kole\304\215ka)</strong> p\305\231edstavuj\303\255 stavy nebo zdroje (nap\305\231. bedna, voln\303\241 linka).</li>\n                <li><strong>P\305\231echody (obd\303\251ln\303\255ky)</strong> p\305\231edstavuj\303\255 ud\303\241losti nebo akce (nap\305\231. pln\304\233n\303\255).</li>\n                <li>P\305\231echod se m\305\257\305\276e aktivovat jen tehdy, kdy\305\276 jsou ve v\305\241ech jeho <strong>vstupn\303\255ch m\303\255stech</strong> \305\276etony.</li>\n                <li>P\305\231i aktivaci p\305\231echod \"spolkne\" \305\276etony ze vstup\305\257 a \"vytvo\305\231\303\255\" nov\303\251 ve v\303\275stupech.</li>\n              </ul>\n            </div>\n          </div>\n        </div>\n\n        {/* Info and History */}\n        <div className=\"lg:col-span-3 flex flex-col gap-6\">\n          <div className=\"bg-white p-8 rounded-[3rem] shadow-xl border border-gray-100 flex flex-col\">\n            <h3 className=\"text-lg font-black text-gray-800 uppercase tracking-tight mb-6\">Pr\305\257b\304\233h</h3>\n            <div className=\"flex-1 overflow-y-auto max-h-[300px] pr-2 flex flex-col gap-3\">\n              {history.map((step, idx) => (\n                <motion.div \n                  initial={{ opacity: 0, x: 20 }}\n                  animate={{ opacity: 1, x: 0 }}\n                  key={idx} \n                  className=\"p-3 bg-gray-50 rounded-xl border border-gray-100 flex items-center gap-3\"\n                >\n                  <div className=\"w-6 h-6 bg-purple-100 rounded-full flex items-center justify-center text-[10px] font-black text-purple-600\">\n                    {idx + 1}\n                  </div>\n                  <span className=\"text-xs font-bold text-gray-600 uppercase tracking-wider\">{step}</span>\n                </motion.div>\n              ))}\n              {history.length === 0 && (\n                <div className=\"flex flex-col items-center justify-center py-10 text-gray-300\">\n                  <Play className=\"w-8 h-8 mb-2 opacity-20\" />\n                  <p className=\"text-[10px] font-black uppercase tracking-widest\">\304\214ek\303\241m na start...</p>\n                </div>\n              )}\n            </div>\n          </div>\n\n          <div className=\"bg-gradient-to-br from-indigo-600 to-purple-700 p-8 rounded-[3rem] shadow-xl text-white\">\n            <h3 className=\"text-sm font-black uppercase tracking-widest mb-4 flex items-center gap-2\">\n              <CircleDot className=\"w-4 h-4\" />\n              Zad\303\241n\303\255\n            </h3>\n            <p className=\"text-[10px] font-medium leading-relaxed opacity-90 italic\">\n              \"P\305\231edstavte si provoz na pln\304\233n\303\255 a z\303\241tkov\303\241n\303\255 lahv\303\255. Jedna linka lahve napln\303\255, voz\303\255k je p\305\231eveze do meziskladu. Pokud je volno na druh\303\251 lince, jin\303\275 voz\303\255k je p\305\231eveze k zaz\303\241tkov\303\241n\303\255.\"\n            </p>\n            <div className=\"mt-6 pt-6 border-t border-white/20 flex flex-col gap-3\">\n              <div className=\"flex items-center gap-3\">\n                <Droplets className=\"w-4 h-4 text-blue-300\" />\n                <span className=\"text-[10px] font-black uppercase tracking-tighter\">Linka 1: Pln\304\233n\303\255</span>\n              </div>\n              <div className=\"flex items-center gap-3\">\n                <Truck className=\"w-4 h-4 text-amber-300\" />\n                <span className=\"text-[10px] font-black uppercase tracking-tighter\">Voz\303\255k: Mezisklad</span>\n              </div>\n              <div className=\"flex items-center gap-3\">\n                <Package className=\"w-4 h-4 text-emerald-300\" />\n                <span className=\"text-[10px] font-black uppercase tracking-tighter\">Linka 2: Z\303\241tkov\303\241n\303\255</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default ParallelProcesses;\n"
    num_lines: 308
    num_bytes: 13182
  }
}
