  view_file {
    absolute_path_uri: "file:///components/PathFindingTask.tsx"
    end_line: 427
    content: "\nimport React, { useState, useMemo, useEffect } from \'react\';\nimport { ArrowLeft, HelpCircle, CheckCircle2, XCircle, RefreshCcw, ChevronRight, ChevronLeft, Map, Search } from \'lucide-react\';\n\ninterface Node {\n  id: string;\n  name: string;\n  x: number;\n  y: number;\n}\n\ninterface Edge {\n  from: string;\n  to: string;\n}\n\ninterface PathLevel {\n  id: number;\n  title: string;\n  startNode: string;\n  endNode: string;\n  nodes: Node[];\n  edges: Edge[];\n}\n\nconst LEVELS: PathLevel[] = [\n  {\n    id: 1,\n    title: \"Z\303\241kladn\303\255 trasy\",\n    startNode: \"A\",\n    endNode: \"H\",\n    nodes: [\n      { id: \"A\", name: \"Al\303\255kov\", x: 50, y: 150 },\n      { id: \"B\", name: \"Bojarov\", x: 200, y: 50 },\n      { id: \"C\", name: \"Clean\303\255\", x: 200, y: 250 },\n      { id: \"H\", name: \"Harrykov\", x: 350, y: 150 },\n    ],\n    edges: [\n      { from: \"A\", to: \"B\" },\n      { from: \"A\", to: \"C\" },\n      { from: \"B\", to: \"H\" },\n      { from: \"C\", to: \"H\" },\n    ]\n  },\n  {\n    id: 2,\n    title: \"P\305\231es Dixice\",\n    startNode: \"A\",\n    endNode: \"H\",\n    nodes: [\n      { id: \"A\", name: \"Al\303\255kov\", x: 50, y: 150 },\n      { id: \"B\", name: \"Bojarov\", x: 150, y: 50 },\n      { id: \"C\", name: \"Clean\303\255\", x: 150, y: 250 },\n      { id: \"D\", name: \"Dixice\", x: 250, y: 150 },\n      { id: \"H\", name: \"Harrykov\", x: 350, y: 150 },\n    ],\n    edges: [\n      { from: \"A\", to: \"B\" },\n      { from: \"A\", to: \"C\" },\n      { from: \"B\", to: \"D\" },\n      { from: \"C\", to: \"D\" },\n      { from: \"D\", to: \"H\" },\n    ]\n  },\n  {\n    id: 3,\n    title: \"K\305\231\303\255\305\276en\303\255 cest\",\n    startNode: \"A\",\n    endNode: \"H\",\n    nodes: [\n      { id: \"A\", name: \"Al\303\255kov\", x: 50, y: 150 },\n      { id: \"B\", name: \"Bojarov\", x: 150, y: 50 },\n      { id: \"C\", name: \"Clean\303\255\", x: 150, y: 250 },\n      { id: \"D\", name: \"Dixice\", x: 250, y: 150 },\n      { id: \"H\", name: \"Harrykov\", x: 350, y: 150 },\n    ],\n    edges: [\n      { from: \"A\", to: \"B\" },\n      { from: \"A\", to: \"C\" },\n      { from: \"B\", to: \"C\" },\n      { from: \"B\", to: \"D\" },\n      { from: \"C\", to: \"D\" },\n      { from: \"D\", to: \"H\" },\n    ]\n  },\n  {\n    id: 4,\n    title: \"Slo\305\276it\304\233j\305\241\303\255 s\303\255\305\245\",\n    startNode: \"A\",\n    endNode: \"H\",\n    nodes: [\n      { id: \"A\", name: \"Al\303\255kov\", x: 50, y: 150 },\n      { id: \"B\", name: \"Bojarov\", x: 150, y: 50 },\n      { id: \"C\", name: \"Clean\303\255\", x: 150, y: 250 },\n      { id: \"D\", name: \"Dixice\", x: 250, y: 150 },\n      { id: \"F\", name: \"Flekovice\", x: 350, y: 150 },\n      { id: \"H\", name: \"Harrykov\", x: 450, y: 150 },\n    ],\n    edges: [\n      { from: \"A\", to: \"B\" },\n      { from: \"A\", to: \"C\" },\n      { from: \"B\", to: \"D\" },\n      { from: \"B\", to: \"F\" },\n      { from: \"C\", to: \"D\" },\n      { from: \"D\", to: \"F\" },\n      { from: \"F\", to: \"H\" },\n    ]\n  },\n  {\n    id: 5,\n    title: \"\305\240t\304\233kav\303\275 kraj (PDF)\",\n    startNode: \"A\",\n    endNode: \"H\",\n    nodes: [\n      { id: \"A\", name: \"Al\303\255kov\", x: 50, y: 150 },\n      { id: \"B\", name: \"Bojarov\", x: 150, y: 80 },\n      { id: \"C\", name: \"Clean\303\255\", x: 150, y: 220 },\n      { id: \"D\", name: \"Dixice\", x: 250, y: 150 },\n      { id: \"E\", name: \"Ellanov\", x: 250, y: 50 },\n      { id: \"F\", name: \"Flekovice\", x: 350, y: 100 },\n      { id: \"G\", name: \"Gorov\", x: 350, y: 200 },\n      { id: \"H\", name: \"Harrykov\", x: 450, y: 150 },\n    ],\n    edges: [\n      { from: \"A\", to: \"B\" },\n      { from: \"A\", to: \"C\" },\n      { from: \"B\", to: \"D\" },\n      { from: \"B\", to: \"F\" },\n      { from: \"C\", to: \"D\" },\n      { from: \"C\", to: \"E\" },\n      { from: \"D\", to: \"F\" },\n      { from: \"E\", to: \"G\" },\n      { from: \"F\", to: \"G\" },\n      { from: \"F\", to: \"H\" },\n      { from: \"G\", to: \"H\" },\n    ]\n  }\n];\n\ninterface PathFindingTaskProps {\n  onBack: () => void;\n}\n\nconst PathFindingTask: React.FC<PathFindingTaskProps> = ({ onBack }) => {\n  const [levelIndex, setLevelIndex] = useState(0);\n  const currentLevel = LEVELS[levelIndex];\n  \n  const [userInput, setUserInput] = useState(\'\');\n  const [foundPaths, setFoundPaths] = useState<string[]>([]);\n  const [feedback, setFeedback] = useState<\'none\' | \'correct\' | \'wrong\' | \'duplicate\'>(\'none\');\n\n  // Calculate all possible paths using DFS\n  const allPaths = useMemo(() => {\n    const adj: { [key: string]: string[] } = {};\n    currentLevel.nodes.forEach(n => adj[n.id] = []);\n    currentLevel.edges.forEach(e => {\n      adj[e.from].push(e.to);\n      adj[e.to].push(e.from); // Undirected\n    });\n\n    const paths: string[] = [];\n    const find = (curr: string, target: string, visited: Set<string>, path: string) => {\n      if (curr === target) {\n        paths.push(path);\n        return;\n      }\n      visited.add(curr);\n      for (const neighbor of adj[curr]) {\n        if (!visited.has(neighbor)) {\n          find(neighbor, target, new Set(visited), path + neighbor);\n        }\n      }\n    };\n\n    find(currentLevel.startNode, currentLevel.endNode, new Set(), currentLevel.startNode);\n    return paths.sort();\n  }, [currentLevel]);\n\n  const handleAddPath = () => {\n    const path = userInput.toUpperCase().trim();\n    if (!path) return;\n\n    if (foundPaths.includes(path)) {\n      setFeedback(\'duplicate\');\n      setTimeout(() => setFeedback(\'none\'), 1500);\n      return;\n    }\n\n    if (allPaths.includes(path)) {\n      setFoundPaths(prev => [...prev, path].sort());\n      setFeedback(\'correct\');\n      setUserInput(\'\');\n      setTimeout(() => setFeedback(\'none\'), 1500);\n    } else {\n      setFeedback(\'wrong\');\n      setTimeout(() => setFeedback(\'none\'), 1500);\n    }\n  };\n\n  const nextLevel = () => {\n    if (levelIndex < LEVELS.length - 1) {\n      setLevelIndex(levelIndex + 1);\n      setFoundPaths([]);\n      setUserInput(\'\');\n      setFeedback(\'none\');\n    }\n  };\n\n  const prevLevel = () => {\n    if (levelIndex > 0) {\n      setLevelIndex(levelIndex - 1);\n      setFoundPaths([]);\n      setUserInput(\'\');\n      setFeedback(\'none\');\n    }\n  };\n\n  const isFinished = foundPaths.length === allPaths.length;\n\n  return (\n    <div className=\"w-full max-w-6xl flex flex-col gap-8 items-center animate-in fade-in duration-500 pb-20\">\n      <div className=\"w-full bg-white p-6 rounded-[2.5rem] shadow-lg border border-gray-100 flex items-center justify-between\">\n        <button \n          onClick={onBack}\n          className=\"flex items-center text-gray-400 hover:text-purple-600 transition-colors font-black uppercase text-xs tracking-widest\"\n        >\n          <ArrowLeft className=\"w-5 h-5 mr-2\" />\n          Zp\304\233t\n        </button>\n        <h2 className=\"text-xl font-black text-gray-800 uppercase tracking-tight\">Hled\303\241n\303\255 v\305\241ech tras</h2>\n        <div className=\"flex items-center gap-4\">\n          <button \n            onClick={prevLevel}\n            disabled={levelIndex === 0}\n            className=\"p-2 hover:bg-purple-50 rounded-xl disabled:opacity-30 transition-colors\"\n          >\n            <ChevronLeft className=\"w-6 h-6 text-purple-600\" />\n          </button>\n          <span className=\"font-black text-purple-600 uppercase text-sm tracking-widest\">\303\232rove\305\210 {levelIndex + 1} / {LEVELS.length}</span>\n          <button \n            onClick={nextLevel}\n            disabled={levelIndex === LEVELS.length - 1}\n            className=\"p-2 hover:bg-purple-50 rounded-xl disabled:opacity-30 transition-colors\"\n          >\n            <ChevronRight className=\"w-6 h-6 text-purple-600\" />\n          </button>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 w-full\">\n        {/* Graph Visualization */}\n        <div className=\"lg:col-span-8 bg-white p-10 rounded-[3rem] shadow-xl border border-gray-100 flex flex-col items-center relative overflow-hidden\">\n          <h3 className=\"text-lg font-black text-gray-800 uppercase tracking-tight mb-8 w-full text-left\">Mapa \305\240t\304\233kav\303\251ho kraje</h3>\n          \n          <div className=\"w-full aspect-[16/9] relative bg-gray-50 rounded-[2rem] border-2 border-dashed border-gray-200 flex items-center justify-center overflow-hidden\">\n            <svg viewBox=\"0 0 500 300\" className=\"w-full h-full p-10\">\n              {/* Edges */}\n              {currentLevel.edges.map((edge, idx) => {\n                const from = currentLevel.nodes.find(n => n.id === edge.from)!;\n                const to = currentLevel.nodes.find(n => n.id === edge.to)!;\n                return (\n                  <line \n                    key={idx}\n                    x1={from.x} y1={from.y}\n                    x2={to.x} y2={to.y}\n                    stroke=\"#e2e8f0\"\n                    strokeWidth=\"4\"\n                    strokeLinecap=\"round\"\n                  />\n                );\n              })}\n              \n              {/* Nodes */}\n              {currentLevel.nodes.map((node) => (\n                <g key={node.id} className=\"group cursor-default\">\n                  <circle \n                    cx={node.x} cy={node.y} r=\"20\"\n                    fill={node.id === currentLevel.startNode ? \"#8b5cf6\" : node.id === currentLevel.endNode ? \"#ec4899\" : \"white\"}\n                    stroke={node.id === currentLevel.startNode ? \"#7c3aed\" : node.id === currentLevel.endNode ? \"#db2777\" : \"#cbd5e1\"}\n                    strokeWidth=\"3\"\n                    className=\"transition-all duration-300 group-hover:scale-110\"\n                  />\n                  <text \n                    x={node.x} y={node.y} \n                    textAnchor=\"middle\" dy=\".3em\"\n                    fill={node.id === currentLevel.startNode || node.id === currentLevel.endNode ? \"white\" : \"#475569\"}\n                    className=\"text-[14px] font-black pointer-events-none\"\n                  >\n                    {node.id}\n                  </text>\n                  <text \n                    x={node.x} y={node.y + 35} \n                    textAnchor=\"middle\"\n                    fill=\"#94a3b8\"\n                    className=\"text-[8px] font-black uppercase tracking-widest pointer-events-none\"\n                  >\n                    {node.name}\n                  </text>\n                </g>\n              ))}\n            </svg>\n\n            <div className=\"absolute top-6 right-6 flex flex-col gap-2\">\n              <div className=\"flex items-center gap-2\">\n                <div className=\"w-3 h-3 rounded-full bg-purple-500\"></div>\n                <span className=\"text-[10px] font-black text-gray-400 uppercase\">Start: {currentLevel.nodes.find(n => n.id === currentLevel.startNode)?.name}</span>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <div className=\"w-3 h-3 rounded-full bg-pink-500\"></div>\n                <span className=\"text-[10px] font-black text-gray-400 uppercase\">C\303\255l: {currentLevel.nodes.find(n => n.id === currentLevel.endNode)?.name}</span>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"mt-8 w-full p-6 bg-blue-50 rounded-2xl border border-blue-100 flex gap-4\">\n            <HelpCircle className=\"w-6 h-6 text-blue-500 shrink-0\" />\n            <p className=\"text-xs text-blue-800 font-medium leading-relaxed\">\n              Najdi v\305\241echny mo\305\276n\303\251 trasy z <strong>{currentLevel.nodes.find(n => n.id === currentLevel.startNode)?.name}</strong> do <strong>{currentLevel.nodes.find(n => n.id === currentLevel.endNode)?.name}</strong>. \n              Zapisuj je jako \305\231et\304\233zec p\303\255smen (nap\305\231. <strong>ABFH</strong>). Ka\305\276d\303\275m m\304\233stem m\305\257\305\276e\305\241 projet jen jednou.\n            </p>\n          </div>\n        </div>\n\n        {/* Input and List */}\n        <div className=\"lg:col-span-4 flex flex-col gap-6\">\n          <div className=\"bg-white p-8 rounded-[3rem] shadow-xl border border-gray-100 flex flex-col items-center\">\n            <h3 className=\"text-lg font-black text-gray-800 uppercase tracking-tight mb-6 w-full text-left\">Zadej trasu</h3>\n            \n            <div className=\"w-full flex flex-col gap-4\">\n              <div className=\"relative\">\n                <input \n                  type=\"text\"\n                  value={userInput}\n                  onChange={(e) => setUserInput(e.target.value.toUpperCase())}\n                  onKeyDown={(e) => e.key === \'Enter\' && handleAddPath()}\n                  placeholder=\"Nap\305\231. ABFH\"\n                  className=\"w-full px-6 py-4 bg-gray-50 border-2 border-gray-100 rounded-2xl text-xl font-black text-purple-600 focus:outline-none focus:border-purple-400 transition-all uppercase tracking-widest\"\n                  disabled={isFinished}\n                />\n                <button \n                  onClick={handleAddPath}\n                  disabled={isFinished || !userInput}\n                  className=\"absolute right-2 top-2 bottom-2 px-4 bg-purple-600 text-white rounded-xl font-black uppercase text-[10px] tracking-widest hover:bg-purple-700 transition-all disabled:opacity-30\"\n                >\n                  P\305\231idat\n                </button>\n              </div>\n\n              <div className=\"h-10 flex items-center justify-center\">\n                {feedback === \'correct\' && (\n                  <div className=\"flex items-center gap-2 text-emerald-500 animate-in zoom-in\">\n                    <CheckCircle2 className=\"w-5 h-5\" />\n                    <span className=\"text-[10px] font-black uppercase tracking-widest\">Spr\303\241vn\303\241 trasa!</span>\n                  </div>\n                )}\n                {feedback === \'wrong\' && (\n                  <div className=\"flex items-center gap-2 text-red-500 animate-in shake\">\n                    <XCircle className=\"w-5 h-5\" />\n                    <span className=\"text-[10px] font-black uppercase tracking-widest\">Neplatn\303\241 trasa</span>\n                  </div>\n                )}\n                {feedback === \'duplicate\' && (\n                  <div className=\"flex items-center gap-2 text-amber-500 animate-in zoom-in\">\n                    <RefreshCcw className=\"w-5 h-5\" />\n                    <span className=\"text-[10px] font-black uppercase tracking-widest\">Tuto trasu u\305\276 m\303\241\305\241</span>\n                  </div>\n                )}\n              </div>\n            </div>\n          </div>\n\n          <div className=\"bg-white p-8 rounded-[3rem] shadow-xl border border-gray-100 flex-1 flex flex-col\">\n            <div className=\"flex items-center justify-between mb-6\">\n              <h3 className=\"text-lg font-black text-gray-800 uppercase tracking-tight\">Nalezen\303\251 trasy</h3>\n              <div className=\"px-3 py-1 bg-purple-100 text-purple-600 rounded-full text-[10px] font-black uppercase tracking-widest\">\n                {foundPaths.length} / {allPaths.length}\n              </div>\n            </div>\n\n            <div className=\"flex-1 overflow-y-auto pr-2 flex flex-col gap-2 min-h-[200px]\">\n              {foundPaths.map((path, idx) => (\n                <div key={idx} className=\"px-4 py-3 bg-gray-50 rounded-xl border border-gray-100 flex items-center justify-between group animate-in slide-in-from-right duration-300\">\n                  <span className=\"font-black text-gray-700 tracking-[0.3em]\">{path}</span>\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-500 opacity-0 group-hover:opacity-100 transition-opacity\" />\n                </div>\n              ))}\n              {foundPaths.length === 0 && (\n                <div className=\"flex-1 flex flex-col items-center justify-center text-center p-10\">\n                  <Search className=\"w-10 h-10 text-gray-200 mb-4\" />\n                  <p className=\"text-[10px] font-black text-gray-300 uppercase tracking-widest\">Zat\303\255m jsi nena\305\241el \305\276\303\241dnou trasu</p>\n                </div>\n              )}\n            </div>\n\n            {isFinished && (\n              <div className=\"mt-6 p-6 bg-emerald-50 rounded-2xl border border-emerald-100 flex flex-col items-center gap-4 animate-in zoom-in\">\n                <p className=\"text-xs text-emerald-800 font-black uppercase tracking-widest text-center\">Na\305\241el jsi v\305\241echny trasy!</p>\n                {levelIndex < LEVELS.length - 1 && (\n                  <button \n                    onClick={nextLevel}\n                    className=\"w-full py-3 bg-emerald-500 text-white rounded-xl font-black uppercase tracking-widest text-[10px] shadow-lg shadow-emerald-100 hover:bg-emerald-600 transition-all\"\n                  >\n                    Dal\305\241\303\255 \303\272rove\305\210\n                  </button>\n                )}\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n\n      <style>{`\n        .shake {\n          animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;\n        }\n        @keyframes shake {\n          10%, 90% { transform: translate3d(-1px, 0, 0); }\n          20%, 80% { transform: translate3d(2px, 0, 0); }\n          30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }\n          40%, 60% { transform: translate3d(4px, 0, 0); }\n        }\n      `}</style>\n    </div>\n  );\n};\n\nexport default PathFindingTask;\n"
    raw_content: "\nimport React, { useState, useMemo, useEffect } from \'react\';\nimport { ArrowLeft, HelpCircle, CheckCircle2, XCircle, RefreshCcw, ChevronRight, ChevronLeft, Map, Search } from \'lucide-react\';\n\ninterface Node {\n  id: string;\n  name: string;\n  x: number;\n  y: number;\n}\n\ninterface Edge {\n  from: string;\n  to: string;\n}\n\ninterface PathLevel {\n  id: number;\n  title: string;\n  startNode: string;\n  endNode: string;\n  nodes: Node[];\n  edges: Edge[];\n}\n\nconst LEVELS: PathLevel[] = [\n  {\n    id: 1,\n    title: \"Z\303\241kladn\303\255 trasy\",\n    startNode: \"A\",\n    endNode: \"H\",\n    nodes: [\n      { id: \"A\", name: \"Al\303\255kov\", x: 50, y: 150 },\n      { id: \"B\", name: \"Bojarov\", x: 200, y: 50 },\n      { id: \"C\", name: \"Clean\303\255\", x: 200, y: 250 },\n      { id: \"H\", name: \"Harrykov\", x: 350, y: 150 },\n    ],\n    edges: [\n      { from: \"A\", to: \"B\" },\n      { from: \"A\", to: \"C\" },\n      { from: \"B\", to: \"H\" },\n      { from: \"C\", to: \"H\" },\n    ]\n  },\n  {\n    id: 2,\n    title: \"P\305\231es Dixice\",\n    startNode: \"A\",\n    endNode: \"H\",\n    nodes: [\n      { id: \"A\", name: \"Al\303\255kov\", x: 50, y: 150 },\n      { id: \"B\", name: \"Bojarov\", x: 150, y: 50 },\n      { id: \"C\", name: \"Clean\303\255\", x: 150, y: 250 },\n      { id: \"D\", name: \"Dixice\", x: 250, y: 150 },\n      { id: \"H\", name: \"Harrykov\", x: 350, y: 150 },\n    ],\n    edges: [\n      { from: \"A\", to: \"B\" },\n      { from: \"A\", to: \"C\" },\n      { from: \"B\", to: \"D\" },\n      { from: \"C\", to: \"D\" },\n      { from: \"D\", to: \"H\" },\n    ]\n  },\n  {\n    id: 3,\n    title: \"K\305\231\303\255\305\276en\303\255 cest\",\n    startNode: \"A\",\n    endNode: \"H\",\n    nodes: [\n      { id: \"A\", name: \"Al\303\255kov\", x: 50, y: 150 },\n      { id: \"B\", name: \"Bojarov\", x: 150, y: 50 },\n      { id: \"C\", name: \"Clean\303\255\", x: 150, y: 250 },\n      { id: \"D\", name: \"Dixice\", x: 250, y: 150 },\n      { id: \"H\", name: \"Harrykov\", x: 350, y: 150 },\n    ],\n    edges: [\n      { from: \"A\", to: \"B\" },\n      { from: \"A\", to: \"C\" },\n      { from: \"B\", to: \"C\" },\n      { from: \"B\", to: \"D\" },\n      { from: \"C\", to: \"D\" },\n      { from: \"D\", to: \"H\" },\n    ]\n  },\n  {\n    id: 4,\n    title: \"Slo\305\276it\304\233j\305\241\303\255 s\303\255\305\245\",\n    startNode: \"A\",\n    endNode: \"H\",\n    nodes: [\n      { id: \"A\", name: \"Al\303\255kov\", x: 50, y: 150 },\n      { id: \"B\", name: \"Bojarov\", x: 150, y: 50 },\n      { id: \"C\", name: \"Clean\303\255\", x: 150, y: 250 },\n      { id: \"D\", name: \"Dixice\", x: 250, y: 150 },\n      { id: \"F\", name: \"Flekovice\", x: 350, y: 150 },\n      { id: \"H\", name: \"Harrykov\", x: 450, y: 150 },\n    ],\n    edges: [\n      { from: \"A\", to: \"B\" },\n      { from: \"A\", to: \"C\" },\n      { from: \"B\", to: \"D\" },\n      { from: \"B\", to: \"F\" },\n      { from: \"C\", to: \"D\" },\n      { from: \"D\", to: \"F\" },\n      { from: \"F\", to: \"H\" },\n    ]\n  },\n  {\n    id: 5,\n    title: \"\305\240t\304\233kav\303\275 kraj (PDF)\",\n    startNode: \"A\",\n    endNode: \"H\",\n    nodes: [\n      { id: \"A\", name: \"Al\303\255kov\", x: 50, y: 150 },\n      { id: \"B\", name: \"Bojarov\", x: 150, y: 80 },\n      { id: \"C\", name: \"Clean\303\255\", x: 150, y: 220 },\n      { id: \"D\", name: \"Dixice\", x: 250, y: 150 },\n      { id: \"E\", name: \"Ellanov\", x: 250, y: 50 },\n      { id: \"F\", name: \"Flekovice\", x: 350, y: 100 },\n      { id: \"G\", name: \"Gorov\", x: 350, y: 200 },\n      { id: \"H\", name: \"Harrykov\", x: 450, y: 150 },\n    ],\n    edges: [\n      { from: \"A\", to: \"B\" },\n      { from: \"A\", to: \"C\" },\n      { from: \"B\", to: \"D\" },\n      { from: \"B\", to: \"F\" },\n      { from: \"C\", to: \"D\" },\n      { from: \"C\", to: \"E\" },\n      { from: \"D\", to: \"F\" },\n      { from: \"E\", to: \"G\" },\n      { from: \"F\", to: \"G\" },\n      { from: \"F\", to: \"H\" },\n      { from: \"G\", to: \"H\" },\n    ]\n  }\n];\n\ninterface PathFindingTaskProps {\n  onBack: () => void;\n}\n\nconst PathFindingTask: React.FC<PathFindingTaskProps> = ({ onBack }) => {\n  const [levelIndex, setLevelIndex] = useState(0);\n  const currentLevel = LEVELS[levelIndex];\n  \n  const [userInput, setUserInput] = useState(\'\');\n  const [foundPaths, setFoundPaths] = useState<string[]>([]);\n  const [feedback, setFeedback] = useState<\'none\' | \'correct\' | \'wrong\' | \'duplicate\'>(\'none\');\n\n  // Calculate all possible paths using DFS\n  const allPaths = useMemo(() => {\n    const adj: { [key: string]: string[] } = {};\n    currentLevel.nodes.forEach(n => adj[n.id] = []);\n    currentLevel.edges.forEach(e => {\n      adj[e.from].push(e.to);\n      adj[e.to].push(e.from); // Undirected\n    });\n\n    const paths: string[] = [];\n    const find = (curr: string, target: string, visited: Set<string>, path: string) => {\n      if (curr === target) {\n        paths.push(path);\n        return;\n      }\n      visited.add(curr);\n      for (const neighbor of adj[curr]) {\n        if (!visited.has(neighbor)) {\n          find(neighbor, target, new Set(visited), path + neighbor);\n        }\n      }\n    };\n\n    find(currentLevel.startNode, currentLevel.endNode, new Set(), currentLevel.startNode);\n    return paths.sort();\n  }, [currentLevel]);\n\n  const handleAddPath = () => {\n    const path = userInput.toUpperCase().trim();\n    if (!path) return;\n\n    if (foundPaths.includes(path)) {\n      setFeedback(\'duplicate\');\n      setTimeout(() => setFeedback(\'none\'), 1500);\n      return;\n    }\n\n    if (allPaths.includes(path)) {\n      setFoundPaths(prev => [...prev, path].sort());\n      setFeedback(\'correct\');\n      setUserInput(\'\');\n      setTimeout(() => setFeedback(\'none\'), 1500);\n    } else {\n      setFeedback(\'wrong\');\n      setTimeout(() => setFeedback(\'none\'), 1500);\n    }\n  };\n\n  const nextLevel = () => {\n    if (levelIndex < LEVELS.length - 1) {\n      setLevelIndex(levelIndex + 1);\n      setFoundPaths([]);\n      setUserInput(\'\');\n      setFeedback(\'none\');\n    }\n  };\n\n  const prevLevel = () => {\n    if (levelIndex > 0) {\n      setLevelIndex(levelIndex - 1);\n      setFoundPaths([]);\n      setUserInput(\'\');\n      setFeedback(\'none\');\n    }\n  };\n\n  const isFinished = foundPaths.length === allPaths.length;\n\n  return (\n    <div className=\"w-full max-w-6xl flex flex-col gap-8 items-center animate-in fade-in duration-500 pb-20\">\n      <div className=\"w-full bg-white p-6 rounded-[2.5rem] shadow-lg border border-gray-100 flex items-center justify-between\">\n        <button \n          onClick={onBack}\n          className=\"flex items-center text-gray-400 hover:text-purple-600 transition-colors font-black uppercase text-xs tracking-widest\"\n        >\n          <ArrowLeft className=\"w-5 h-5 mr-2\" />\n          Zp\304\233t\n        </button>\n        <h2 className=\"text-xl font-black text-gray-800 uppercase tracking-tight\">Hled\303\241n\303\255 v\305\241ech tras</h2>\n        <div className=\"flex items-center gap-4\">\n          <button \n            onClick={prevLevel}\n            disabled={levelIndex === 0}\n            className=\"p-2 hover:bg-purple-50 rounded-xl disabled:opacity-30 transition-colors\"\n          >\n            <ChevronLeft className=\"w-6 h-6 text-purple-600\" />\n          </button>\n          <span className=\"font-black text-purple-600 uppercase text-sm tracking-widest\">\303\232rove\305\210 {levelIndex + 1} / {LEVELS.length}</span>\n          <button \n            onClick={nextLevel}\n            disabled={levelIndex === LEVELS.length - 1}\n            className=\"p-2 hover:bg-purple-50 rounded-xl disabled:opacity-30 transition-colors\"\n          >\n            <ChevronRight className=\"w-6 h-6 text-purple-600\" />\n          </button>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 w-full\">\n        {/* Graph Visualization */}\n        <div className=\"lg:col-span-8 bg-white p-10 rounded-[3rem] shadow-xl border border-gray-100 flex flex-col items-center relative overflow-hidden\">\n          <h3 className=\"text-lg font-black text-gray-800 uppercase tracking-tight mb-8 w-full text-left\">Mapa \305\240t\304\233kav\303\251ho kraje</h3>\n          \n          <div className=\"w-full aspect-[16/9] relative bg-gray-50 rounded-[2rem] border-2 border-dashed border-gray-200 flex items-center justify-center overflow-hidden\">\n            <svg viewBox=\"0 0 500 300\" className=\"w-full h-full p-10\">\n              {/* Edges */}\n              {currentLevel.edges.map((edge, idx) => {\n                const from = currentLevel.nodes.find(n => n.id === edge.from)!;\n                const to = currentLevel.nodes.find(n => n.id === edge.to)!;\n                return (\n                  <line \n                    key={idx}\n                    x1={from.x} y1={from.y}\n                    x2={to.x} y2={to.y}\n                    stroke=\"#e2e8f0\"\n                    strokeWidth=\"4\"\n                    strokeLinecap=\"round\"\n                  />\n                );\n              })}\n              \n              {/* Nodes */}\n              {currentLevel.nodes.map((node) => (\n                <g key={node.id} className=\"group cursor-default\">\n                  <circle \n                    cx={node.x} cy={node.y} r=\"20\"\n                    fill={node.id === currentLevel.startNode ? \"#8b5cf6\" : node.id === currentLevel.endNode ? \"#ec4899\" : \"white\"}\n                    stroke={node.id === currentLevel.startNode ? \"#7c3aed\" : node.id === currentLevel.endNode ? \"#db2777\" : \"#cbd5e1\"}\n                    strokeWidth=\"3\"\n                    className=\"transition-all duration-300 group-hover:scale-110\"\n                  />\n                  <text \n                    x={node.x} y={node.y} \n                    textAnchor=\"middle\" dy=\".3em\"\n                    fill={node.id === currentLevel.startNode || node.id === currentLevel.endNode ? \"white\" : \"#475569\"}\n                    className=\"text-[14px] font-black pointer-events-none\"\n                  >\n                    {node.id}\n                  </text>\n                  <text \n                    x={node.x} y={node.y + 35} \n                    textAnchor=\"middle\"\n                    fill=\"#94a3b8\"\n                    className=\"text-[8px] font-black uppercase tracking-widest pointer-events-none\"\n                  >\n                    {node.name}\n                  </text>\n                </g>\n              ))}\n            </svg>\n\n            <div className=\"absolute top-6 right-6 flex flex-col gap-2\">\n              <div className=\"flex items-center gap-2\">\n                <div className=\"w-3 h-3 rounded-full bg-purple-500\"></div>\n                <span className=\"text-[10px] font-black text-gray-400 uppercase\">Start: {currentLevel.nodes.find(n => n.id === currentLevel.startNode)?.name}</span>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <div className=\"w-3 h-3 rounded-full bg-pink-500\"></div>\n                <span className=\"text-[10px] font-black text-gray-400 uppercase\">C\303\255l: {currentLevel.nodes.find(n => n.id === currentLevel.endNode)?.name}</span>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"mt-8 w-full p-6 bg-blue-50 rounded-2xl border border-blue-100 flex gap-4\">\n            <HelpCircle className=\"w-6 h-6 text-blue-500 shrink-0\" />\n            <p className=\"text-xs text-blue-800 font-medium leading-relaxed\">\n              Najdi v\305\241echny mo\305\276n\303\251 trasy z <strong>{currentLevel.nodes.find(n => n.id === currentLevel.startNode)?.name}</strong> do <strong>{currentLevel.nodes.find(n => n.id === currentLevel.endNode)?.name}</strong>. \n              Zapisuj je jako \305\231et\304\233zec p\303\255smen (nap\305\231. <strong>ABFH</strong>). Ka\305\276d\303\275m m\304\233stem m\305\257\305\276e\305\241 projet jen jednou.\n            </p>\n          </div>\n        </div>\n\n        {/* Input and List */}\n        <div className=\"lg:col-span-4 flex flex-col gap-6\">\n          <div className=\"bg-white p-8 rounded-[3rem] shadow-xl border border-gray-100 flex flex-col items-center\">\n            <h3 className=\"text-lg font-black text-gray-800 uppercase tracking-tight mb-6 w-full text-left\">Zadej trasu</h3>\n            \n            <div className=\"w-full flex flex-col gap-4\">\n              <div className=\"relative\">\n                <input \n                  type=\"text\"\n                  value={userInput}\n                  onChange={(e) => setUserInput(e.target.value.toUpperCase())}\n                  onKeyDown={(e) => e.key === \'Enter\' && handleAddPath()}\n                  placeholder=\"Nap\305\231. ABFH\"\n                  className=\"w-full px-6 py-4 bg-gray-50 border-2 border-gray-100 rounded-2xl text-xl font-black text-purple-600 focus:outline-none focus:border-purple-400 transition-all uppercase tracking-widest\"\n                  disabled={isFinished}\n                />\n                <button \n                  onClick={handleAddPath}\n                  disabled={isFinished || !userInput}\n                  className=\"absolute right-2 top-2 bottom-2 px-4 bg-purple-600 text-white rounded-xl font-black uppercase text-[10px] tracking-widest hover:bg-purple-700 transition-all disabled:opacity-30\"\n                >\n                  P\305\231idat\n                </button>\n              </div>\n\n              <div className=\"h-10 flex items-center justify-center\">\n                {feedback === \'correct\' && (\n                  <div className=\"flex items-center gap-2 text-emerald-500 animate-in zoom-in\">\n                    <CheckCircle2 className=\"w-5 h-5\" />\n                    <span className=\"text-[10px] font-black uppercase tracking-widest\">Spr\303\241vn\303\241 trasa!</span>\n                  </div>\n                )}\n                {feedback === \'wrong\' && (\n                  <div className=\"flex items-center gap-2 text-red-500 animate-in shake\">\n                    <XCircle className=\"w-5 h-5\" />\n                    <span className=\"text-[10px] font-black uppercase tracking-widest\">Neplatn\303\241 trasa</span>\n                  </div>\n                )}\n                {feedback === \'duplicate\' && (\n                  <div className=\"flex items-center gap-2 text-amber-500 animate-in zoom-in\">\n                    <RefreshCcw className=\"w-5 h-5\" />\n                    <span className=\"text-[10px] font-black uppercase tracking-widest\">Tuto trasu u\305\276 m\303\241\305\241</span>\n                  </div>\n                )}\n              </div>\n            </div>\n          </div>\n\n          <div className=\"bg-white p-8 rounded-[3rem] shadow-xl border border-gray-100 flex-1 flex flex-col\">\n            <div className=\"flex items-center justify-between mb-6\">\n              <h3 className=\"text-lg font-black text-gray-800 uppercase tracking-tight\">Nalezen\303\251 trasy</h3>\n              <div className=\"px-3 py-1 bg-purple-100 text-purple-600 rounded-full text-[10px] font-black uppercase tracking-widest\">\n                {foundPaths.length} / {allPaths.length}\n              </div>\n            </div>\n\n            <div className=\"flex-1 overflow-y-auto pr-2 flex flex-col gap-2 min-h-[200px]\">\n              {foundPaths.map((path, idx) => (\n                <div key={idx} className=\"px-4 py-3 bg-gray-50 rounded-xl border border-gray-100 flex items-center justify-between group animate-in slide-in-from-right duration-300\">\n                  <span className=\"font-black text-gray-700 tracking-[0.3em]\">{path}</span>\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-500 opacity-0 group-hover:opacity-100 transition-opacity\" />\n                </div>\n              ))}\n              {foundPaths.length === 0 && (\n                <div className=\"flex-1 flex flex-col items-center justify-center text-center p-10\">\n                  <Search className=\"w-10 h-10 text-gray-200 mb-4\" />\n                  <p className=\"text-[10px] font-black text-gray-300 uppercase tracking-widest\">Zat\303\255m jsi nena\305\241el \305\276\303\241dnou trasu</p>\n                </div>\n              )}\n            </div>\n\n            {isFinished && (\n              <div className=\"mt-6 p-6 bg-emerald-50 rounded-2xl border border-emerald-100 flex flex-col items-center gap-4 animate-in zoom-in\">\n                <p className=\"text-xs text-emerald-800 font-black uppercase tracking-widest text-center\">Na\305\241el jsi v\305\241echny trasy!</p>\n                {levelIndex < LEVELS.length - 1 && (\n                  <button \n                    onClick={nextLevel}\n                    className=\"w-full py-3 bg-emerald-500 text-white rounded-xl font-black uppercase tracking-widest text-[10px] shadow-lg shadow-emerald-100 hover:bg-emerald-600 transition-all\"\n                  >\n                    Dal\305\241\303\255 \303\272rove\305\210\n                  </button>\n                )}\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n\n      <style>{`\n        .shake {\n          animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;\n        }\n        @keyframes shake {\n          10%, 90% { transform: translate3d(-1px, 0, 0); }\n          20%, 80% { transform: translate3d(2px, 0, 0); }\n          30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }\n          40%, 60% { transform: translate3d(4px, 0, 0); }\n        }\n      `}</style>\n    </div>\n  );\n};\n\nexport default PathFindingTask;\n"
    num_lines: 428
    num_bytes: 16657
  }
}
