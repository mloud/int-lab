  view_file {
    absolute_path_uri: "file:///App.tsx"
    end_line: 176
    content: "\nimport React, { useState } from \'react\';\nimport LandingPage from \'./components/LandingPage\';\nimport SplashScreen from \'./components/SplashScreen\';\nimport Menu from \'./components/Menu\';\nimport RGBDrawing from \'./components/RGBDrawing\';\nimport Quiz from \'./components/Quiz\';\nimport LinesMenu from \'./components/LinesMenu\';\nimport VectorDrawing from \'./components/VectorDrawing\';\nimport ShapePuzzle from \'./components/ShapePuzzle\';\nimport CompressionMenu from \'./components/CompressionMenu\';\nimport CompressionGame from \'./components/CompressionGame\';\nimport CustomCompression from \'./components/CustomCompression\';\nimport TextCompression from \'./components/TextCompression\';\nimport ChecksumGame from \'./components/ChecksumGame\';\nimport BinaryMenu from \'./components/BinaryMenu\';\nimport TeachersOffice from \'./components/TeachersOffice\';\nimport StudentCounting from \'./components/StudentCounting\';\nimport BinaryToDecimal from \'./components/BinaryToDecimal\';\nimport TruthTable from \'./components/TruthTable\';\nimport BinaryAddition from \'./components/BinaryAddition\';\nimport ModelsMenu from \'./components/ModelsMenu\';\nimport TimetableGraph from \'./components/TimetableGraph\';\nimport { Screen, Difficulty, Segment } from \'./types\';\nimport { ROCKET_DATA, CAT_DATA, COMPUTER_DATA } from \'./constants\';\n\nconst App: React.FC = () => {\n  const [currentScreen, setCurrentScreen] = useState<Screen>(\'landing\');\n  const [selectedData, setSelectedData] = useState<Segment[]>([]);\n  const [levelName, setLevelName] = useState<string>(\'\');\n\n  const handleStartLevel = (difficulty: Difficulty) => {\n    switch (difficulty) {\n      case \'easy\':\n        setSelectedData(ROCKET_DATA);\n        setLevelName(\'Raketa\');\n        break;\n      case \'medium\':\n        setSelectedData(CAT_DATA);\n        setLevelName(\'Ko\304\215ka\');\n        break;\n      case \'hard\':\n        setSelectedData(COMPUTER_DATA);\n        setLevelName(\'Po\304\215\303\255ta\304\215\');\n        break;\n    }\n    setCurrentScreen(\'drawing\');\n  };\n\n  const renderScreen = () => {\n    switch (currentScreen) {\n      case \'landing\':\n        return (\n          <LandingPage \n            onStartColors={() => setCurrentScreen(\'splash\')} \n            onStartLines={() => setCurrentScreen(\'lines-menu\')} \n            onStartCompression={() => setCurrentScreen(\'compression-menu\')}\n            onStartBinary={() => setCurrentScreen(\'binary-menu\')}\n          />\n        );\n      case \'binary-menu\':\n        return (\n          <BinaryMenu \n            onStartTeachers={() => setCurrentScreen(\'teachers-office\')}\n            onStartCounting={() => setCurrentScreen(\'student-counting\')}\n            onStartBinaryToDecimal={() => setCurrentScreen(\'binary-to-decimal\')}\n            onStartTruthTable={() => setCurrentScreen(\'truth-table\')}\n            onStartAddition={() => setCurrentScreen(\'binary-addition\')}\n            onBack={() => setCurrentScreen(\'landing\')}\n          />\n        );\n      case \'teachers-office\':\n        return <TeachersOffice onBack={() => setCurrentScreen(\'binary-menu\')} />;\n      case \'student-counting\':\n        return <StudentCounting onBack={() => setCurrentScreen(\'binary-menu\')} />;\n      case \'binary-to-decimal\':\n        return <BinaryToDecimal onBack={() => setCurrentScreen(\'binary-menu\')} />;\n      case \'truth-table\':\n        return <TruthTable onBack={() => setCurrentScreen(\'binary-menu\')} />;\n      case \'binary-addition\':\n        return <BinaryAddition onBack={() => setCurrentScreen(\'binary-menu\')} />;\n      case \'compression-menu\':\n        return (\n          <CompressionMenu \n            onStartGame={() => setCurrentScreen(\'compression-game\')}\n            onStartText={() => setCurrentScreen(\'text-compression\')}\n            onStartChecksum={() => setCurrentScreen(\'checksum-game\')}\n            onBack={() => setCurrentScreen(\'landing\')}\n          />\n        );\n      case \'compression-game\':\n        return (\n          <CompressionGame \n            onBack={() => setCurrentScreen(\'compression-menu\')} \n            onStartCustom={() => setCurrentScreen(\'custom-compression\')}\n          />\n        );\n      case \'custom-compression\':\n        return (\n          <CustomCompression onBack={() => setCurrentScreen(\'compression-game\')} />\n        );\n      case \'text-compression\':\n        return (\n          <TextCompression onBack={() => setCurrentScreen(\'compression-menu\')} />\n        );\n      case \'checksum-game\':\n        return (\n          <ChecksumGame onBack={() => setCurrentScreen(\'compression-menu\')} />\n        );\n      case \'lines-menu\':\n        return (\n          <LinesMenu \n            onShapePuzzle={() => setCurrentScreen(\'shape-puzzle\')}\n            onVectorDrawing={() => setCurrentScreen(\'vector-drawing\')}\n            onLineDrawing={() => setCurrentScreen(\'line-drawing\')}\n            onBack={() => setCurrentScreen(\'landing\')}\n          />\n        );\n      case \'shape-puzzle\':\n        return (\n          <ShapePuzzle onBack={() => setCurrentScreen(\'lines-menu\')} />\n        );\n      case \'vector-drawing\':\n        return (\n          <VectorDrawing \n            mode=\"points\"\n            onBack={() => setCurrentScreen(\'lines-menu\')}\n          />\n        );\n      case \'line-drawing\':\n        return (\n          <VectorDrawing \n            mode=\"lines\"\n            onBack={() => setCurrentScreen(\'lines-menu\')}\n          />\n        );\n      case \'splash\':\n        return (\n          <SplashScreen \n            onEnter={() => setCurrentScreen(\'menu\')} \n            onQuiz={() => setCurrentScreen(\'quiz\')}\n            onBack={() => setCurrentScreen(\'landing\')}\n          />\n        );\n      case \'menu\':\n        return <Menu onStart={handleStartLevel} onBack={() => setCurrentScreen(\'splash\')} />;\n      case \'drawing\':\n        return (\n          <RGBDrawing \n            onBack={() => setCurrentScreen(\'menu\')} \n            initialSegments={selectedData}\n            title={levelName}\n          />\n        );\n      case \'quiz\':\n        return <Quiz onBack={() => setCurrentScreen(\'splash\')} />;\n      default:\n        return (\n          <LandingPage \n            onStartColors={() => setCurrentScreen(\'splash\')} \n            onStartLines={() => setCurrentScreen(\'lines-menu\')} \n            onStartCompression={() => setCurrentScreen(\'compression-menu\')} \n            onStartBinary={() => setCurrentScreen(\'binary-menu\')}\n          />\n        );\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen flex flex-col items-center justify-center p-4 bg-[#f8fafc]\">\n      {renderScreen()}\n    </div>\n  );\n};\n\nexport default App;\n"
    raw_content: "\nimport React, { useState } from \'react\';\nimport LandingPage from \'./components/LandingPage\';\nimport SplashScreen from \'./components/SplashScreen\';\nimport Menu from \'./components/Menu\';\nimport RGBDrawing from \'./components/RGBDrawing\';\nimport Quiz from \'./components/Quiz\';\nimport LinesMenu from \'./components/LinesMenu\';\nimport VectorDrawing from \'./components/VectorDrawing\';\nimport ShapePuzzle from \'./components/ShapePuzzle\';\nimport CompressionMenu from \'./components/CompressionMenu\';\nimport CompressionGame from \'./components/CompressionGame\';\nimport CustomCompression from \'./components/CustomCompression\';\nimport TextCompression from \'./components/TextCompression\';\nimport ChecksumGame from \'./components/ChecksumGame\';\nimport BinaryMenu from \'./components/BinaryMenu\';\nimport TeachersOffice from \'./components/TeachersOffice\';\nimport StudentCounting from \'./components/StudentCounting\';\nimport BinaryToDecimal from \'./components/BinaryToDecimal\';\nimport TruthTable from \'./components/TruthTable\';\nimport BinaryAddition from \'./components/BinaryAddition\';\nimport ModelsMenu from \'./components/ModelsMenu\';\nimport TimetableGraph from \'./components/TimetableGraph\';\nimport { Screen, Difficulty, Segment } from \'./types\';\nimport { ROCKET_DATA, CAT_DATA, COMPUTER_DATA } from \'./constants\';\n\nconst App: React.FC = () => {\n  const [currentScreen, setCurrentScreen] = useState<Screen>(\'landing\');\n  const [selectedData, setSelectedData] = useState<Segment[]>([]);\n  const [levelName, setLevelName] = useState<string>(\'\');\n\n  const handleStartLevel = (difficulty: Difficulty) => {\n    switch (difficulty) {\n      case \'easy\':\n        setSelectedData(ROCKET_DATA);\n        setLevelName(\'Raketa\');\n        break;\n      case \'medium\':\n        setSelectedData(CAT_DATA);\n        setLevelName(\'Ko\304\215ka\');\n        break;\n      case \'hard\':\n        setSelectedData(COMPUTER_DATA);\n        setLevelName(\'Po\304\215\303\255ta\304\215\');\n        break;\n    }\n    setCurrentScreen(\'drawing\');\n  };\n\n  const renderScreen = () => {\n    switch (currentScreen) {\n      case \'landing\':\n        return (\n          <LandingPage \n            onStartColors={() => setCurrentScreen(\'splash\')} \n            onStartLines={() => setCurrentScreen(\'lines-menu\')} \n            onStartCompression={() => setCurrentScreen(\'compression-menu\')}\n            onStartBinary={() => setCurrentScreen(\'binary-menu\')}\n          />\n        );\n      case \'binary-menu\':\n        return (\n          <BinaryMenu \n            onStartTeachers={() => setCurrentScreen(\'teachers-office\')}\n            onStartCounting={() => setCurrentScreen(\'student-counting\')}\n            onStartBinaryToDecimal={() => setCurrentScreen(\'binary-to-decimal\')}\n            onStartTruthTable={() => setCurrentScreen(\'truth-table\')}\n            onStartAddition={() => setCurrentScreen(\'binary-addition\')}\n            onBack={() => setCurrentScreen(\'landing\')}\n          />\n        );\n      case \'teachers-office\':\n        return <TeachersOffice onBack={() => setCurrentScreen(\'binary-menu\')} />;\n      case \'student-counting\':\n        return <StudentCounting onBack={() => setCurrentScreen(\'binary-menu\')} />;\n      case \'binary-to-decimal\':\n        return <BinaryToDecimal onBack={() => setCurrentScreen(\'binary-menu\')} />;\n      case \'truth-table\':\n        return <TruthTable onBack={() => setCurrentScreen(\'binary-menu\')} />;\n      case \'binary-addition\':\n        return <BinaryAddition onBack={() => setCurrentScreen(\'binary-menu\')} />;\n      case \'compression-menu\':\n        return (\n          <CompressionMenu \n            onStartGame={() => setCurrentScreen(\'compression-game\')}\n            onStartText={() => setCurrentScreen(\'text-compression\')}\n            onStartChecksum={() => setCurrentScreen(\'checksum-game\')}\n            onBack={() => setCurrentScreen(\'landing\')}\n          />\n        );\n      case \'compression-game\':\n        return (\n          <CompressionGame \n            onBack={() => setCurrentScreen(\'compression-menu\')} \n            onStartCustom={() => setCurrentScreen(\'custom-compression\')}\n          />\n        );\n      case \'custom-compression\':\n        return (\n          <CustomCompression onBack={() => setCurrentScreen(\'compression-game\')} />\n        );\n      case \'text-compression\':\n        return (\n          <TextCompression onBack={() => setCurrentScreen(\'compression-menu\')} />\n        );\n      case \'checksum-game\':\n        return (\n          <ChecksumGame onBack={() => setCurrentScreen(\'compression-menu\')} />\n        );\n      case \'lines-menu\':\n        return (\n          <LinesMenu \n            onShapePuzzle={() => setCurrentScreen(\'shape-puzzle\')}\n            onVectorDrawing={() => setCurrentScreen(\'vector-drawing\')}\n            onLineDrawing={() => setCurrentScreen(\'line-drawing\')}\n            onBack={() => setCurrentScreen(\'landing\')}\n          />\n        );\n      case \'shape-puzzle\':\n        return (\n          <ShapePuzzle onBack={() => setCurrentScreen(\'lines-menu\')} />\n        );\n      case \'vector-drawing\':\n        return (\n          <VectorDrawing \n            mode=\"points\"\n            onBack={() => setCurrentScreen(\'lines-menu\')}\n          />\n        );\n      case \'line-drawing\':\n        return (\n          <VectorDrawing \n            mode=\"lines\"\n            onBack={() => setCurrentScreen(\'lines-menu\')}\n          />\n        );\n      case \'splash\':\n        return (\n          <SplashScreen \n            onEnter={() => setCurrentScreen(\'menu\')} \n            onQuiz={() => setCurrentScreen(\'quiz\')}\n            onBack={() => setCurrentScreen(\'landing\')}\n          />\n        );\n      case \'menu\':\n        return <Menu onStart={handleStartLevel} onBack={() => setCurrentScreen(\'splash\')} />;\n      case \'drawing\':\n        return (\n          <RGBDrawing \n            onBack={() => setCurrentScreen(\'menu\')} \n            initialSegments={selectedData}\n            title={levelName}\n          />\n        );\n      case \'quiz\':\n        return <Quiz onBack={() => setCurrentScreen(\'splash\')} />;\n      default:\n        return (\n          <LandingPage \n            onStartColors={() => setCurrentScreen(\'splash\')} \n            onStartLines={() => setCurrentScreen(\'lines-menu\')} \n            onStartCompression={() => setCurrentScreen(\'compression-menu\')} \n            onStartBinary={() => setCurrentScreen(\'binary-menu\')}\n          />\n        );\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen flex flex-col items-center justify-center p-4 bg-[#f8fafc]\">\n      {renderScreen()}\n    </div>\n  );\n};\n\nexport default App;\n"
