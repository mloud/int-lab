  user_input {
    user_response: "Here is the full initial file tree for the application:\n/.env.local\n/.gitignore\n/App.tsx\n/components/ChecksumGame.tsx\n/components/ColorMixer.tsx\n/components/CompressionGame.tsx\n/components/CompressionMenu.tsx\n/components/LandingPage.tsx\n/components/LinesMenu.tsx\n/components/Menu.tsx\n/components/MixingMenu.tsx\n/components/Quiz.tsx\n/components/RGBDrawing.tsx\n/components/ShapePuzzle.tsx\n/components/SplashScreen.tsx\n/components/TextCompression.tsx\n/components/VectorDrawing.tsx\n/constants.ts\n/index.html\n/index.tsx\n/metadata.json\n/migrated_prompt_history/prompt_2026-02-18T12:53:44.036Z.json\n/package.json\n/tsconfig.json\n/types.ts\n/vite.config.ts\n\nThe following dependencies are installed:\nlucide-react: ^0.562.0\nreact: ^19.2.3\nreact-dom: ^19.2.3\n\nThe following devDependencies are installed:\n@types/node: ^22.14.0\n@vitejs/plugin-react: ^5.0.0\ntypescript: ~5.8.2\nvite: ^6.2.0\n\nKey file contents:\n\n--- /App.tsx ---\n```typescript\n\nimport React, { useState } from \'react\';\nimport LandingPage from \'./components/LandingPage\';\nimport SplashScreen from \'./components/SplashScreen\';\nimport Menu from \'./components/Menu\';\nimport RGBDrawing from \'./components/RGBDrawing\';\nimport Quiz from \'./components/Quiz\';\nimport LinesMenu from \'./components/LinesMenu\';\nimport VectorDrawing from \'./components/VectorDrawing\';\nimport ShapePuzzle from \'./components/ShapePuzzle\';\nimport CompressionMenu from \'./components/CompressionMenu\';\nimport CompressionGame from \'./components/CompressionGame\';\nimport TextCompression from \'./components/TextCompression\';\nimport ChecksumGame from \'./components/ChecksumGame\';\nimport { Screen, Difficulty, Segment } from \'./types\';\nimport { ROCKET_DATA, CAT_DATA, COMPUTER_DATA } from \'./constants\';\n\nconst App: React.FC = () => {\n  const [currentScreen, setCurrentScreen] = useState<Screen>(\'landing\');\n  const [selectedData, setSelectedData] = useState<Segment[]>([]);\n  const [levelName, setLevelName] = useState<string>(\'\');\n\n  const handleStartLevel = (difficulty: Difficulty) => {\n    switch (difficulty) {\n      case \'easy\':\n        setSelectedData(ROCKET_DATA);\n        setLevelName(\'Raketa\');\n        break;\n      case \'medium\':\n        setSelectedData(CAT_DATA);\n        setLevelName(\'Ko\304\215ka\');\n        break;\n      case \'hard\':\n        setSelectedData(COMPUTER_DATA);\n        setLevelName(\'Po\304\215\303\255ta\304\215\');\n        break;\n    }\n    setCurrentScreen(\'drawing\');\n  };\n\n  const renderScreen = () => {\n    switch (currentScreen) {\n      case \'landing\':\n        return (\n          <LandingPage \n            onStartColors={() => setCurrentScreen(\'splash\')} \n            onStartLines={() => setCurrentScreen(\'lines-menu\')} \n            onStartCompression={() => setCurrentScreen(\'compression-menu\')}\n          />\n        );\n      case \'compression-menu\':\n        return (\n          <CompressionMenu \n            onStartGame={() => setCurrentScreen(\'compression-game\')}\n            onStartText={() => setCurrentScreen(\'text-compression\')}\n            onStartChecksum={() => setCurrentScreen(\'checksum-game\')}\n            onBack={() => setCurrentScreen(\'landing\')}\n          />\n        );\n      case \'compression-game\':\n        return (\n          <CompressionGame onBack={() => setCurrentScreen(\'compression-menu\')} />\n        );\n      case \'text-compression\':\n        return (\n          <TextCompression onBack={() => setCurrentScreen(\'compression-menu\')} />\n        );\n      case \'checksum-game\':\n        return (\n          <ChecksumGame onBack={() => setCurrentScreen(\'compression-menu\')} />\n        );\n      case \'lines-menu\':\n        return (\n          <LinesMenu \n            onShapePuzzle={() => setCurrentScreen(\'shape-puzzle\')}\n            onVectorDrawing={() => setCurrentScreen(\'vector-drawing\')}\n            onLineDrawing={() => setCurrentScreen(\'line-drawing\')}\n            onBack={() => setCurrentScreen(\'landing\')}\n          />\n        );\n      case \'shape-puzzle\':\n        return (\n          <ShapePuzzle onBack={() => setCurrentScreen(\'lines-menu\')} />\n        );\n      case \'vector-drawing\':\n        return (\n          <VectorDrawing \n            mode=\"points\"\n            onBack={() => setCurrentScreen(\'lines-menu\')}\n          />\n        );\n      case \'line-drawing\':\n        return (\n          <VectorDrawing \n            mode=\"lines\"\n            onBack={() => setCurrentScreen(\'lines-menu\')}\n          />\n        );\n      case \'splash\':\n        return (\n          <SplashScreen \n            onEnter={() => setCurrentScreen(\'menu\')} \n            onQuiz={() => setCurrentScreen(\'quiz\')}\n            onBack={() => setCurrentScreen(\'landing\')}\n          />\n        );\n      case \'menu\':\n        return <Menu onStart={handleStartLevel} onBack={() => setCurrentScreen(\'splash\')} />;\n      case \'drawing\':\n        return (\n          <RGBDrawing \n            onBack={() => setCurrentScreen(\'menu\')} \n            initialSegments={selectedData}\n            title={levelName}\n          />\n        );\n      case \'quiz\':\n        return <Quiz onBack={() => setCurrentScreen(\'splash\')} />;\n      default:\n        return <LandingPage onStartColors={() => setCurrentScreen(\'splash\')} onStartLines={() => setCurrentScreen(\'lines-menu\')} onStartCompression={() => setCurrentScreen(\'compression-menu\')} />;\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen flex flex-col items-center justify-center p-4 bg-[#f8fafc]\">\n      {renderScreen()}\n    </div>\n  );\n};\n\nexport default App;\n\n```\n\n--- /index.html ---\n```html\n\n<!DOCTYPE html>\n<html lang=\"cs\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>RGB Master</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body {\n            font-family: \'Quicksand\', sans-serif;\n            background: #f0f4f8;\n        }\n    </style>\n<script type=\"importmap\">\n{\n  \"imports\": {\n    \"lucide-react\": \"https://esm.sh/lucide-react@^0.562.0\",\n    \"react-dom/\": \"https://esm.sh/react-dom@^19.2.3/\",\n    \"react/\": \"https://esm.sh/react@^19.2.3/\",\n    \"react\": \"https://esm.sh/react@^19.2.3\"\n  }\n}\n</script>\n<link rel=\"stylesheet\" href=\"/index.css\">\n</head>\n<body>\n    <div id=\"root\"></div>\n<script type=\"module\" src=\"/index.tsx\"></script>\n</body>\n</html>\n\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"Informatika ZS\",\n  \"description\": \"Interaktivn\303\255 aplikace pro v\303\275uku RGB k\303\263dov\303\241n\303\255 barev. \305\275\303\241ci vybarvuj\303\255 obr\303\241zek zad\303\241v\303\241n\303\255m p\305\231esn\303\275ch \304\215\303\255seln\303\275ch hodnot \304\215erven\303\251, zelen\303\251 a modr\303\251 slo\305\276ky.\",\n  \"requestFramePermissions\": []\n}\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"experimentalDecorators\": true,\n    \"useDefineForClassFields\": false,\n    \"module\": \"ESNext\",\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"skipLibCheck\": true,\n    \"types\": [\n      \"node\"\n    ],\n    \"moduleResolution\": \"bundler\",\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"allowJs\": true,\n    \"jsx\": \"react-jsx\",\n    \"paths\": {\n      \"@/*\": [\n        \"./*\"\n      ]\n    },\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true\n  }\n}\n```\n\n--- /vite.config.ts ---\n```typescript\nimport path from \'path\';\nimport { defineConfig, loadEnv } from \'vite\';\nimport react from \'@vitejs/plugin-react\';\n\nexport default defineConfig(({ mode }) => {\n    const env = loadEnv(mode, \'.\', \'\');\n    return {\n      server: {\n        port: 3000,\n        host: \'0.0.0.0\',\n      },\n      plugins: [react()],\n      define: {\n        \'process.env.API_KEY\': JSON.stringify(env.GEMINI_API_KEY),\n        \'process.env.GEMINI_API_KEY\': JSON.stringify(env.GEMINI_API_KEY)\n      },\n      resolve: {\n        alias: {\n          \'@\': path.resolve(__dirname, \'.\'),\n        }\n      }\n    };\n});\n\n```"
