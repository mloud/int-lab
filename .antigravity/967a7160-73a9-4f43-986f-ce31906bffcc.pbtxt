  checkpoint {
    user_intent: "Adding Custom Image Compression\n\nThe user wants to extend the image compression screen with a new activity. This activity will allow students to draw their own images on an 18x18 grid, compress them, and then have their work checked for correctness. This new feature should be accessible from the `CompressionGame` screen."
    intent_only: true
